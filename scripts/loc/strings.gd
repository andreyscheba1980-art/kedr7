	&"fj.title": ["НАРЯДЫ НА ВЫЕЗД (пайков: %d)", "FIELD JOBS (rations: %d)"],
	&"fj.carry_samples": ["→ везу кейс с пробами на станцию", "→ carrying the sample case to the station"],
	&"fj.carry_battery": ["→ везу аккумулятор для АМС", "→ carrying a battery for the AWS"],
	&"fj.obj_deliver": ["Довезти кейс с пробами до станции", "Bring the sample case to the station"],
	&"fj.obj": ["Наряд: %s (осталось %d)", "Job: %s (%d left)"],
	&"fj.all_done": ["Все наряды на сегодня закрыты.", "All of today's jobs are done."],
	&"fj.radio": ["Свердловск по рации: «Кедр-7, наряды на день: %s. На схеме обведено красным».", "Sverdlovsk on the radio: \"Kedr-7, today's jobs: %s. Circled in red on the map.\""],
	&"fj.samples_done": ["Кейс с пробами сдан.", "Sample case delivered."],
	&"fj.it_reset": ["[Удерживать E] Перезапустить АМС: питание, кварц, передатчик", "[Hold E] Restart the AWS: power, crystal, transmitter"],
	&"fj.it_battery": ["[Удерживать E] Поставить новый аккумулятор", "[Hold E] Install the new battery"],
	&"fj.it_battery_need": ["[E] Аккумулятор сел — нужен новый (гараж)", "[E] The battery's dead — need a new one (garage)"],
	&"fj.it_log": ["[E] Открыть шкаф АМС: журнал обходов", "[E] Open the AWS cabinet: patrol log"],
	&"fj.reset_done": ["Передатчик щёлкнул и пошёл. АМС на связи.", "The transmitter clicked and started up. The AWS is back on air."],
	&"fj.battery_done": ["Новый аккумулятор на месте. Станция ожила.", "New battery in. The station came back to life."],
	&"fj.battery_need_sub": ["Аккумулятор мёртвый. Новый — в гараже, у северной стены.", "The battery's dead. There's a new one in the garage, by the north wall."],
	&"fj.it_ice": ["[Удерживать E] Обстучать мачту — сбить лёд с датчиков", "[Hold E] Hammer the mast — knock the ice off the sensors"],
	&"fj.ice_done": ["Лёд осыпался. Чашки анемометра снова крутятся.", "The ice came off. The anemometer cups are spinning again."],
	&"fj.it_tape": ["[Удерживать E] Сменить ленту самописца", "[Hold E] Change the recorder tape"],
	&"fj.it_tape_idle": ["Самописец вышки. Перо ползёт по ленте.", "The tower's chart recorder. The pen crawls along the tape."],
	&"fj.tape_done": ["Лента снята. Всю ночь ровная линия, а в 03:10 — зубец до края шкалы.", "Tape removed. A flat line all night — and at 03:10 a spike to the edge of the scale."],
	&"fj.it_samples": ["[E] Взять кейс с пробами снега", "[E] Take the snow sample case"],
	&"fj.samples_taken": ["Кейс тяжелее, чем должен быть. Довезти до станции.", "The case is heavier than it should be. Bring it to the station."],
	&"fj.it_take_battery": ["[E] Взять аккумулятор 6СТ-190 для АМС", "[E] Take a 6ST-190 battery for the AWS"],
	&"fj.it_battery_spare": ["Запасные аккумуляторы 6СТ-190", "Spare 6ST-190 batteries"],
	&"fj.battery_taken": ["Аккумулятор пуда на два. Довезу на «Буране».", "The battery weighs a ton. I'll take it on the Buran."],
	&"fj.voice_1": ["Из шкафа, сквозь треск: «...Кедр-7, это АМС. Мы тебя видим».", "From the cabinet, through static: \"...Kedr-7, this is the AWS. We can see you.\""],
	&"fj.voice_2": ["В шкафу щёлкнул передатчик. Голос — твой собственный: «Обход закончен. Возвращаюсь».", "The transmitter clicked in the cabinet. A voice — your own: \"Patrol finished. Heading back.\""],
	&"fj.voice_3": ["Эфир в шкафу шепчет цифры. Те же, что диктуют из-под пола.", "The cabinet's radio whispers numbers. The same ones dictated from under the floor."],
	&"fj.log_ams1": ["ЖУРНАЛ ОБХОДА АМС-1 «ПЕРЕВАЛ»\n\n12.11 — замена АКБ. Ветер СЗ 8. Курочкин.\n03.12 — сбит лёд с датчиков. Курочкин.\n19.12 — перезапуск. Вокруг мачты следы, босые. Курочкин.\n20.12 — следы снова. От шкафа в лес и обратно.\n21.12 —\n\n(дальше пусто, карандаш вдавлен в бумагу)", "PATROL LOG, AWS-1 \"PASS\"\n\n12.11 — battery replaced. Wind NW 8. Kurochkin.\n03.12 — ice knocked off the sensors. Kurochkin.\n19.12 — restart. Footprints around the mast, barefoot. Kurochkin.\n20.12 — the footprints again. From the cabinet to the woods and back.\n21.12 —\n\n(blank after that, the pencil pressed into the paper)"],
	&"fj.log_ams2": ["ЖУРНАЛ ОБХОДА АМС-2 «ЛЕСОСЕЧНАЯ»\n\n07.11 — профилактика. Семёнов.\n28.11 — замена АКБ. Шкаф был заперт изнутри: защёлка повёрнута внутрь. Семёнов.\n02.12 — опять изнутри. Защёлку снял, выбросил.\n09.12 — защёлка на месте.", "PATROL LOG, AWS-2 \"LOGGING\"\n\n07.11 — maintenance. Semyonov.\n28.11 — battery replaced. The cabinet was locked from inside: the latch turned inward. Semyonov.\n02.12 — locked from inside again. Took the latch off, threw it away.\n09.12 — the latch is back."],
	&"fj.log_ams3": ["ЖУРНАЛ ОБХОДА АМС-3 «БУРОВАЯ»\n\n15.11 — сбит лёд. Курочкин.\n30.11 — на мачте висела варежка. Не наша, детская. Снял, положил в шкаф. Семёнов.\n01.12 — варежки в шкафу нет.\n06.12 — висит на мачте.", "PATROL LOG, AWS-3 \"DRILL\"\n\n15.11 — ice knocked off. Kurochkin.\n30.11 — a mitten was hanging on the mast. Not ours, a child's. Took it down, put it in the cabinet. Semyonov.\n01.12 — no mitten in the cabinet.\n06.12 — it's hanging on the mast."],
	&"fj.log_ams4": ["ЖУРНАЛ ОБХОДА АМС-4 «ЗИМНИК»\n\n22.11 — перезапуск. Курочкин.\n05.12 — замена АКБ. Семёнов.\n\nПоследние три записи — одним почерком, но подписаны разными фамилиями:\n«Курочкин», «Семёнов» — и «Витя».", "PATROL LOG, AWS-4 \"WINTER ROAD\"\n\n22.11 — restart. Kurochkin.\n05.12 — battery replaced. Semyonov.\n\nThe last three entries are in one hand, but signed with different names:\n\"Kurochkin\", \"Semyonov\" — and \"Vitya\"."],
	&"site.zimnik_sign": ["ЗИМНИК\n← Большая Земля 140 км\n→ ст. «Кедр-7» 0,4 км", "WINTER ROAD\n← Mainland 140 km\n→ Kedr-7 station 0.4 km"],
	&"site.tower.note": ["Метеовышка, 1958 г. Журнал наблюдателя (последняя страница)\n\n«12 янв. Ветер СЗ 14 м/с. Флюгер заклинило, полез наверх — с площадки видно огни на северном склоне. Огней там быть не может, там ничего нет.\n\n14 янв. Огни ближе. Кто-то ходит вокруг будки и стучит в стенку по три раза. Я не открываю.\n\n15 янв. Стучат изнутри.»\n\nДальше страница вырвана. В будке — канистра бензина, кто-то оставил её «для своих».", "Weather tower, 1958. Observer's log (last page)\n\n\"Jan 12. Wind NW 14 m/s. Vane jammed, climbed up — from the deck I can see lights on the north slope. There can't be lights there, there is nothing there.\n\nJan 14. Lights are closer. Someone walks around the hut and knocks on the wall three times. I don't open.\n\nJan 15. The knocking is from inside.\"\n\nThe rest is torn out. In the hut — a fuel canister, left 'for our own'."],
	&"site.camp.note": ["Лесосека леспромхоза. Записка на двери вагончика\n\n«Бригада ушла на Большую Землю 3 марта. Технику бросили — ГТ-Т не заводится, бензин оставили в вагончике.\n\nЕсли ты Семёнов — не ходи на делянку за брёвнами. Пилы там не наши. И по ночам не отвечай, когда зовут по имени: Колька откликнулся.\n\nНайду поймать не смогли — забилась под нары в дальнем вагончике и не выходит. Прости нас, Найда.\n\nМастер Гурьянов.»", "Logging camp. Note on the trailer door\n\n\"The crew left for the mainland on March 3. Left the machinery — the GT-T won't start, fuel is in the trailer.\n\nIf you're Semyonov — don't go to the cutting for logs. The saws there aren't ours. And at night don't answer when they call your name: Kolka answered.\n\nWe couldn't catch Naida — she hid under the bunks in the far trailer and won't come out. Forgive us, Naida.\n\nForeman Guryanov.\""],
	&"site.drill.note": ["Буровая СБУ-3, геологоразведка. Буровой журнал\n\n«Глубина 412 м. Керн — лёд, в нём пузыри воздуха, пахнет как в погребе.\n\nГлубина 438 м. Снаряд провалился в пустоту. Из скважины тянет тёплым. Ночью оттуда слышно дыхание, ровное, как у спящего.\n\nСкважину приказано заглушить. Глушили три смены. На четвёртую ночь заглушку нашли у балка, аккуратно положенную на крыльцо.»\n\nПод журналом — схема: от буровой к станции идёт пунктир с подписью «Отзвук».", "SBU-3 drill rig, geological survey. Drilling log\n\n\"Depth 412 m. Core — ice, air bubbles in it, smells like a root cellar.\n\nDepth 438 m. The bit dropped into a void. Warm air comes up the hole. At night you can hear breathing down there, even, like someone asleep.\n\nOrdered to plug the hole. Three shifts plugged it. On the fourth night the plug was found by the hut, neatly placed on the porch.\"\n\nUnder the log — a sketch: a dotted line from the rig to the station, labeled 'Otzvuk'."],
	&"tut.buran": ["Расчехлить «Буран» у гаража и проехать по зимнику (100 м)", "Uncover the Buran by the garage and ride the winter road (100 m)"],
	&"it.buran_tarp": ["[E] Снять чехол со снегохода", "[E] Pull the cover off the snowmobile"],
	&"it.buran_ride": ["[E] Сесть на «Буран» (бак: %d%%)", "[E] Get on the Buran (tank: %d%%)"],
	&"it.buran_refuel": ["[E] Залить бензин в «Буран»", "[E] Fuel the Buran"],
	&"sub.buran_night": ["Снегоход под чехлом. Утром разберёмся.", "A snowmobile under a cover. Morning will do."],
	&"sub.buran_uncovered": ["«Буран» Семёнова. Бак наполовину, свеча сухая. Должен завестись.", "Semyonov's Buran. Half a tank, dry plug. Should start."],
	&"sub.buran_filled": ["Бак полный.", "Tank full."],
	&"sub.buran_hands": ["Руки заняты.", "Hands are full."],
	&"sub.buran_controls": ["W — газ, S — тормоз/назад, A/D — руль, E — слезть. Ночью мотор слышно далеко.", "W throttle, S brake/reverse, A/D steer, E get off. At night the engine carries far."],
	&"sub.buran_too_fast": ["Сначала остановись.", "Stop first."],
	&"sub.buran_empty": ["Бак пустой. Нужна канистра.", "Tank's empty. Need a canister."],
	&"sub.buran_nostart": ["Чихнул и заглох. Ещё раз.", "Coughed and died. Again."],
	&"sub.buran_controls2": ["W — газ, S — тормоз/назад, A/D — руль, E — слезть. По зимнику — до тридцати, в целине вязнет. Ночью мотор слышно далеко.", "W throttle, S brake/reverse, A/D steer, E get off. Up to thirty on the winter road; it bogs down in deep snow. At night the engine carries far."],
	&"sub.buran_deep": ["Целина. «Буран» еле ползёт и проваливается.", "Deep snow. The Buran barely crawls and sinks."],
	&"sub.buran_stuck": ["Зарылся. Сдай назад и попробуй снова — или по своему следу.", "Dug in. Back up and try again — or follow your own track."],
	&"sub.buran_stall": ["Мотор чихнул и заглох. На морозе свечу заливает.", "The engine coughed and died. The plug floods in this cold."],
	&"tut.journal": ["Прочитать журнал Семёнова на столе", "Read Semyonov's log on the desk"],
	&"tut.rest": ["Всё готово. Кровать — отдохнуть до ночи", "All set. Use the bed to rest until night"],
	&"tutg.done": ["✓  %s", "✓  %s"],
	&"tutg.readings.title": ["Снять показания: площадка и корпус", "Take readings: the plot and the building"],
	&"tutg.readings.how": ["Корпус с башней — в ста метрах к востоку, по лееру с красными флажками. По пути — огороженная площадка. В будке два термометра: найди верх красного столбика (колёсико — вдоль шкалы, ночью свети фонарём [F], иней стирай ЛКМ) и впиши цифры в книжку. На рейке читай высоту там, где снег сходится с рейкой. Давление — барограф у рации: где перо сейчас и насколько изменилось за три часа. Ветер — в корпусе: заведи дизель в пристройке, потом пульт в аппаратной — стрелки считывай сам. Огонёк покажет, что осталось.", "The building with the tower is a hundred metres east, along the rope with red flags. On the way is a fenced plot. The screen holds two thermometers: find the top of the red column (wheel moves along the scale, use the flashlight [F] at night, wipe frost with LMB) and write the numbers in the book. At the snow stake, read the depth where the snow meets the stake. Pressure — the barograph by the radio: where the pen is now and how much it changed in three hours. Wind is inside: start the diesel in the annex, then the panel in the instrument room — read the needles yourself. The light shows what is left."],
	&"tutg.test_report.title": ["Передать пробную сводку", "Send a test report"],
	&"tutg.test_report.how": ["Рация — в рубке. Сядь за неё [E], поймай Большую Землю на 6880 кГц и нажми [R]: замеры уйдут в Свердловск.", "The radio is in the radio room. Sit at it [E], find the Mainland at 6880 kHz and press [R]: the readings go to Sverdlovsk."],
	&"tutg.refuel.title": ["Залить солярку в генератор", "Refuel the generator"],
	&"tutg.refuel.how": ["Канистры — на верстаке в сарае ГСМ (жёлтые флажки). Возьми одну [E] и неси в будку дизельной за домом, к генератору [E].", "The cans are on the workbench in the fuel shed (yellow flags). Take one [E] and carry it to the generator shack behind the house [E]."],
	&"tutg.wood.title": ["Подкинуть дров в печь", "Feed the stove"],
	&"tutg.wood.how": ["Поленница — на южной поляне (зелёные флажки). Набери охапку [E], занеси в дом и подкинь в печь в жилой комнате [E].", "The woodpile is in the south clearing (green flags). Take an armful [E], carry it in and feed the stove in the living room [E]."],
	&"tutg.buran.title": ["Расчехлить «Буран»", "Uncover the Buran"],
	&"tutg.buran.how": ["Снегоход стоит под брезентом у гаража. Сними чехол [E], садись и проедь по зимнику сто метров — днём на нём ездят по нарядам.", "The snowmobile is under a tarp by the garage. Pull the cover [E], get on and ride the winter road for a hundred metres — by day it takes you to field jobs."],
	&"tutg.journal.title": ["Прочитать журнал Семёнова", "Read Semyonov's log"],
	&"tutg.journal.how": ["Журнал лежит на столе в рубке, рядом с рацией [E]. В нём — правила станции. Их стоит запомнить до темноты.", "The log is on the desk in the radio room, next to the radio [E]. It holds the station rules. Learn them before dark."],
	&"tut.done": ["Готово.", "Done."],
	&"pro.start": ["Вездеход встал у края просеки. Водитель машет рукой.", "The crawler stopped at the edge of the clearing. The driver waves."],
	&"pro.leaving": ["Вездеход уходит в буран. Обратной дороги нет.", "The crawler vanishes into the blizzard. There is no turning back."],
	&"tut.morning_start": ["Наступило утро. Пора осмотреться и проверить станцию: печь, генератор, приборы и рацию.", "Morning has arrived. Time to inspect the station: stove, generator, weather instruments, and radio."],
	&"obj.reach_station": ["Дойти до станции по просеке, держась леера", "Reach the station along the forest cut, keeping to the rope"],
	&"obj.cabin_ride": ["Рейс на перевал «Кедр-7» в кабине ГТ-Т", "Ride to the Kedr-7 pass in the crawler cabin"],
	&"obj.take_trunk": ["Забрать экспедиционный рундук и снаряжение из кузова ГТ-Т", "Take expedition trunk and gear from the crawler bed"],
	&"obj.carry_trunk": ["Донести экспедиционный рундук до метеостанции «Кедр-7»", "Carry expedition trunk to polar station Kedr-7"],
	&"obj.heat_stove": ["Растопить печь дровами и согреть дом станции", "Stoke the stove with firewood to warm the station"],
	&"obj.radio_report": ["Доложить штабу о прибытии (рация Р-250, 6880 кГц, [R])", "Report arrival at Kedr-7 (R-250 radio, 6880 kHz, [R])"],
	&"obj.sleep_arrival": ["Запереть дверь и лечь спать", "Bolt the door and go to bed"],
	&"sub.need_trunk_first": ["«Куда без рундука рванул?! Забирай казённое имущество из кузова!»", "'Where are you running off to without the trunk?! Grab the gear from the bed!'"],
	&"sub.bed_need_trunk": ["Рундук со снаряжением остался снаружи на морозе! Сначала занеси его в избу.", "The expedition trunk is still outside in the cold! Bring it inside first."],
	&"sub.bed_need_heat": ["В избе лютый мороз, зубы сводит! Нужно растопить печь и согреть дом.", "It's freezing inside the cabin! Stoke the stove to heat the house."],
	&"sub.bed_need_radio": ["Сначала нужно доложить штабу о прибытии на волне 6880 кГц!", "First you must report arrival to HQ on 6880 kHz!"],
	&"it.bed_cold": ["Кровать (в избе лютый мороз)", "Bed (freezing cold in cabin)"],
	&"it.bed_sleep_arrival": ["[E] Лечь спать (заступить на ночную вахту)", "[E] Go to sleep (assume night watch)"],
	&"card.prologue_night1": ["14 ноября 1983 г.\nМетеостанция «Кедр-7»\nЗаступление на ночную вахту.", "November 14, 1983\nPolar Station 'Kedr-7'\nAssuming the night watch."],
	&"driver.farewell_3b": ["МИХАЛЫЧ (из окна): По вешкам и по верёвке. Не срезай. Меня до весны не жди.", "MIKHALYCH (from the window): Follow the markers and the rope. Don't cut corners. Don't expect me before spring."],
	&"sub.bed_door_open": ["Сначала закрой входную дверь.", "Close the front door first."],
	&"cab.1": ["МИХАЛЫЧ: Мальцев, проснулся?", "MIKHALYCH: Mal'tsev, awake?"],
	&"cab.2": ["ВИКТОР: Давно едем?", "VIKTOR: How long have we been driving?"],
	&"cab.3": ["МИХАЛЫЧ: А тебе зачем? Часы всё равно врут.", "MIKHALYCH: What's it to you? Clocks lie out here anyway."],
	&"cab.4": ["ВИКТОР: На станции свет есть?", "VIKTOR: Is there power at the station?"],
	&"cab.5": ["МИХАЛЫЧ: По последней сводке был.", "MIKHALYCH: According to the last report, there was."],
	&"cab.6": ["ВИКТОР: По какой последней?", "VIKTOR: The last what?"],
	&"cab.7": ["МИХАЛЫЧ: По той, что мне дали. Я за сводки не отвечаю.", "MIKHALYCH: The one they handed me. I don't answer for reports."],
	&"cab.8": ["МИХАЛЫЧ: Всё. Дальше пешком — просека узкая, тягач не пройдёт.", "MIKHALYCH: That's it. On foot from here — the cut's too narrow for the crawler."],
	&"cab.9": ["ВИКТОР: Тут же ничего не видно.", "VIKTOR: You can't see anything out there."],
	&"cab.10": ["МИХАЛЫЧ: Вешки со световозвращателями увидишь в луче ФАС-4. Не увидишь — стой. Только с зимника не сходи.\nИ ещё... Если снизу услышишь чужой мотор — не вздумай откликаться. Здесь звук по склону гуляет.", "MIKHALYCH: You'll see the retro-reflector markers in the FAS-4 beam. Can't see them — halt. Just don't leave the winter road.\nAnd one more thing... If you hear a foreign engine below — don't you dare respond. Sound wanders the slopes here."],
	&"cab.11": ["МИХАЛЫЧ: Ты сам-то чего сюда? Молодой, с дипломом. Сидел бы в Свердловске при управлении.", "MIKHALYCH: So why'd you come out here? Young, got a diploma. Could've sat in Sverdlovsk at the directorate."],
	&"cab.12": ["ВИКТОР: Северные. Полгода — и на кооператив хватит. Жена с дочкой в общежитии, втроём в одной комнате.", "VIKTOR: The northern bonus. Six months and we can afford a co-op flat. My wife and daughter are in a dorm — three of us in one room."],
	&"cab.13": ["МИХАЛЫЧ: Северные... Семёнов тоже за северными ехал.", "MIKHALYCH: The bonus... Semyonov came for the bonus too."],
	&"cab.14": ["ВИКТОР: Это который до меня был?", "VIKTOR: The one before me?"],
	&"cab.15": ["МИХАЛЫЧ: Был. В ноябре ушёл с метеоплощадки — и всё. Нарты нашли у просеки. Его — нет.", "MIKHALYCH: Was. In November he walked off the weather yard — and that was it. Found his sled by the cut. Not him."],
	&"cab.16": ["ВИКТОР: Медведь?", "VIKTOR: A bear?"],
	&"cab.17": ["МИХАЛЫЧ: Медведь зимой спит. Местные говорят — ырка. Ночью зовёт. Голосом, который ты знаешь. Не отзывайся. И дверь никому не открывай.", "MIKHALYCH: Bears sleep in winter. The locals say it's the yrka. It calls at night. In a voice you know. Don't answer. And don't open the door to anyone."],
	&"cab.18": ["МИХАЛЫЧ: Через семь дней приеду за тобой — посигналю три раза. Кто стучит и не сигналит — это не я. Даже если моим голосом.", "MIKHALYCH: In seven days I'll come for you — I'll honk three times. Anyone who knocks and doesn't honk — it's not me. Even if it uses my voice."],
	&"th.cab": ["(Байки. Ему просто скучно возить одних и тех же.)", "(Campfire stories. He's just bored of hauling the same faces.)"],
	&"th.cold_1": ["(Не открывай. Только не открывай.)", "(Don't open it. Just don't open it.)"],
	&"th.cold_2": ["(Это не Михалыч. Михалыч сигналит три раза.)", "(That's not Mikhalych. Mikhalych honks three times.)"],
	&"cold.whisper": ["(шёпот за спиной) Витя...", "(a whisper right behind you) Vitya..."],
	&"cold.before": ["ЗА СЕМЬ ДНЕЙ ДО ЭТОГО", "SEVEN DAYS EARLIER"],
	&"th.alone": ["(Триста метров. По верёвке. В минус сорок. Отличное начало, Витя.)", "(Three hundred metres. Along a rope. At forty below. Great start, Vitya.)"],
	&"th.crack": ["(Мороз деревья рвёт. Как выстрелы.)", "(The frost is splitting the trees. Like gunshots.)"],
	&"th.runner": ["(Кто там?.. Лось. Это был лось.)", "(Who's there?.. A moose. It was a moose.)"],
	&"th.sled": ["(Нарты Семёнова. Значит, он шёл к станции... и не дошёл?)", "(Semyonov's sled. So he was heading for the station... and never got there?)"],
	&"th.izba": ["(Свет же горел. Я видел.)", "(The light was on. I saw it.)"],
	&"th.follower": ["(Шаги... Это эхо. Просто эхо. Не оборачивайся.)", "(Footsteps... It's an echo. Just an echo. Don't turn around.)"],
	&"th.station": ["(Вот она. «Кедр-7». Дошёл.)", "(There it is. Kedr-7. Made it.)"],
	&"th.door": ["(Дверь открыта. Подпёрта поленом. Кто её открыл?)", "(The door's open. Propped with a log. Who opened it?)"],
	&"th.call": ["(Свистят. Это не птица. Не останавливайся.)", "(Someone's whistling. That's no bird. Keep walking.)"],
	&"pro.call_name": ["(шёпот из чащи) Ви-тя...", "(a whisper from the thicket) Vi-tya..."],
	&"pro.own_voice": ["РАЦИЯ (твоим голосом): …Кедр-7 вызывает Управление. Мальцев на месте. Прошу подтвердить приём.", "RADIO (in your own voice): …Kedr-7 calling Control. Mal'tsev on site. Please confirm."],
	&"th.own_voice": ["(Это мой голос. Я же ещё ничего не передавал.)", "(That's my voice. I haven't transmitted anything yet.)"],
	&"th.bolt": ["(Засов. «Дверь никому не открывай». Хорошо, Михалыч.)", "(The bolt. \"Don't open the door to anyone.\" Fine, Mikhalych.)"],
	&"th.morning": ["(Утро. Если это можно назвать утром.)", "(Morning. If you can call this morning.)"],
	&"cab.stuck": ["МИХАЛЫЧ: Сели. Перемёт под катками. Вылазь, Витя, лопата за сиденьем — откопаем, сам не выберусь.", "MIKHALYCH: We're stuck. Drift under the road wheels. Out you get, Vitya, shovel's behind the seat — we'll dig her out, I can't do it alone."],
	&"cab.wait_hint": ["Михалыч кричит вслед из кабины — дослушай его у тягача, потом в путь.", "Mikhalych is shouting after you from the cab — hear him out by the crawler, then go."],
	&"cab.dig": ["[E держать] Откапывать гусеницу", "[hold E] Dig out the track"],
	&"cab.dig_hint": ["МИХАЛЫЧ (из кабины): Под передними катками греби, с обеих сторон. Я подгазую, как скажешь.", "MIKHALYCH (from the cab): Shovel under the front road wheels, both sides. I'll rev when you say."],
	&"cab.try": ["МИХАЛЫЧ: Отойди! Газую!", "MIKHALYCH: Stand clear! Giving it gas!"],
	&"cab.track": ["МИХАЛЫЧ: Трак лопнул. Приехали...", "MIKHALYCH: Track link snapped. That's it..."],
	&"cab.stay": ["МИХАЛЫЧ: Я тут заночую, печку в кабине раскочегарю. К утру трактор с Сороковой вызову.", "MIKHALYCH: I'll spend the night here, fire up the cab stove. By morning I'll call a tractor from Forty."],
	&"obj.dig": ["Откопать гусеницы ГТ-Т: перемёт под передними катками", "Dig out the crawler's tracks: drift under the front road wheels"],
	&"th.engine": ["(Заглох. Или заглушил... Михалыч?)", "(It stalled. Or he shut it off... Mikhalych?)"],
	&"th.figure": ["(Там кто-то стоял. Стоял и смотрел. Это пень. Пень...)", "(Someone was standing there. Standing and watching. It's a stump. A stump...)"],
	&"cab.exit": ["[E] Выйти из тягача в буран", "[E] Step out of the crawler into the blizzard"],
	&"driver.farewell_1": ["МИХАЛЫЧ: До станции — по вешкам. Если занесёт, не срезай.", "MIKHALYCH: Down to the station — follow the markers. If it drifts over, don't cut corners."],
	&"driver.farewell_2": ["ВИКТОР: А если вешек не будет?", "VIKTOR: And if there are no markers?"],
	&"driver.farewell_3": ["МИХАЛЫЧ: Тогда стой.", "MIKHALYCH: Then stay put."],
	&"driver.pro1": ["МИХАЛЫЧ: До станции — по вешкам. Если занесёт, не срезай.", "MIKHALYCH: Down to the station — follow the markers. If it drifts over, don't cut corners."],
	&"driver.pro2": ["МИХАЛЫЧ: Снаряжение на нартах: рундук, солярка, запчасти и фонарь ФАС-4. Держи упряжь!", "MIKHALYCH: Your gear is on the sled: trunk, diesel, spare parts and FAS-4 lantern. Take the harness!"],
	&"driver.pro3": ["МИХАЛЫЧ: Вон вешки со световозвращателями. Иди строго по ним вниз в котловину к станции.", "MIKHALYCH: Look at the reflector road markers. Follow them down the hollow to the station."],
	&"driver.pro4": ["МИХАЛЫЧ: Дойдёшь — печь растопи, дизель крутани и отбейся штабу на волне 6880 кГц. Бывай!", "MIKHALYCH: Once there — light the stove, crank the diesel and report to HQ on 6880 kHz. Safe watch!"],
	&"trail.alone": ["Гул дизеля тает за спиной. Дальше — только просека и леер вдоль неё.", "The diesel's drone fades behind you. Ahead — only the forest cut and the rope along it."],
	&"trail.branch": ["Мороз под сорок... Стволы вековых елей трещат от стужи, словно выстрелы.", "Near forty below... The old spruce trunks crack in the frost like rifle shots."],
	&"trail.snapped_post": ["Трос сорван... Столб вывернуло из мерзлоты со льдом. На ветру гудят натянутые провода.", "The guide wire is snapped... The post was torn out of the permafrost. Wires hum in the gale."],
	&"trail.seemed": ["В разрыве позёмки мелькнул красный огонь мачты на сопке... станция где-то внизу.", "Through a break in the snow drift, the red mast beacon flashed... the station is down below."],
	&"trail.drag_tracks": ["Поперёк зимника — старые надувы и след от полозьев, уходящий в целину.", "Across the winter road — old wind slabs and runner tracks leading into deep snow."],
	&"trail.bare_feet": ["Следы на снегу... припорошенные позёмкой.", "Tracks in the snow... dusted over by the blizzard."],
	&"trail.wire_hum": ["Вдалеке по проводам ЛЭП гудит ледяной ветер, отмеряя дорогу.", "Far along the power lines, the icy wind hums, measuring the road."],
	&"trail.steps_behind": ["Сзади шуршит снег под полозьями нарт...", "Snow rustles behind under the sled runners..."],
	&"trail.steps_stop": ["Шуршание позади затихло.", "The rustling behind has stopped."],
	&"trail.window_silhouette": ["Окна станции затянуты сплошным белым инеем... Внутри мёртвая темнота.", "The station windows are opaque with thick frost... Dead darkness inside."],
	&"trail.porch": ["Крыльцо станции. Входная дверь распахнута настежь, петли скрипят на ветру.", "The station porch. The front door hangs wide open, hinges creaking in the gale."],
	&"trail.sled_interact": ["[E] Осмотреть брошенные нарты Семёнова", "[E] Examine Semyonov's abandoned sled"],
	&"trail.post_interact": ["[E] Осмотреть вывороченный столб", "[E] Examine the torn post"],
	&"trail.sled_note": ["ЗАПИСКА СЕМЁНОВА (карандашом на промокшей бумаге):\n\n«Дежурство сдал. По журналу — 12-е число. Приказано ждать сменщика до 15-го.\nЕсли опять придёт бумага с подписью начальника — не принимай её, пока не услышишь его по радио.\nЯ уже принял одну.\n\n[На обороте спешно нацарапано:]\n6880. После 23:00 не отвечать.»", "SEMYONOV'S NOTE (pencil on damp paper):\n\n\"Watch handed over. Log says 12th. Ordered to wait for relief until 15th.\nIf another dispatch arrives signed by the chief — do not accept it until you hear him on the radio.\nI already accepted one.\n\n[On the reverse, hastily scratched:]\n6880. Do not answer after 23:00.\""],
	&"radio.prologue_v1": ["ВИКТОР: Кедр-7 вызывает Управление. Мальцев на месте. Прошу подтвердить приём.", "VIKTOR: Kedr-7 calling Control. Mal'tsev on site. Acknowledge transmission."],
	&"radio.prologue_hq1": ["УПРАВЛЕНИЕ: …Кедр-7, позывной принят. Мальцев, заступление подтверждаем.", "CONTROL: ...Kedr-7, callsign acknowledged. Mal'tsev, watch confirmed."],
	&"radio.prologue_v2": ["ВИКТОР: Станция выморожена, печь растопил, генератор в работе. Жду указаний.", "VIKTOR: Station was frozen, stove lit, generator running. Awaiting orders."],
	&"radio.prologue_hq2": ["УПРАВЛЕНИЕ: Сводки строго по расписанию. На перевале штормовое. Конец связи.", "CONTROL: Reports strictly on schedule. Storm warning on the pass. Out."],
	&"radio.prologue_v3": ["ВИКТОР: Вас понял. Конец связи.", "VIKTOR: Understood. Out."],
	&"radio.prologue_hq3": ["УПРАВЛЕНИЕ: [в эфире только низкий гул несущей частоты]", "CONTROL: [carrier frequency low drone only]"],
	&"radio.prologue_v4": ["ВИКТОР: Радиомолчание. Связь проверена... До утра бы поспать. Кровать в жилой комнате.", "VIKTOR: Radio silence. Contact confirmed... Need some sleep until morning. The bed is in the living quarters."],
	&"sub.distant_engine": ["В наступившей тишине... далеко с перевала донёсся глухой, низкий рокот чужого дизеля на гусеницах.", "In the sudden silence... from far up the mountain pass echoed the low, heavy thrum of a foreign crawler engine."],
	&"sub.engine_warning_memory": ["Слова Михалыча: «Если снизу услышишь чужой мотор — не откликайся...»", "Mikhalych's words: \"If you hear a foreign engine down below — do not answer...\""],
	&"sled.harness_take": ["[E] Взять упряжь нарт", "[E] Take sled harness"],
	&"sled.harness_drop": ["[E] Бросить упряжь нарт", "[E] Drop sled harness"],
	&"it.take_cargo": ["[E] Взять: %s", "[E] Take: %s"],
	&"sub.sled_hitched": ["Лямка упряжи на плече. Нарты скрипнули по насту.", "Harness strap over shoulder. Sled runners crunched on the snow crust."],
	&"sub.sled_dropped": ["Сбросил лямку упряжи.", "Dropped the harness strap."],
	&"sub.took_cargo": ["Взял в руки: %s", "Picked up: %s"],
	&"sub.placed_cargo": ["Погрузил на нарты: %s", "Loaded onto sled: %s"],
	&"it.valenki_semenov": ["[E] Валенки у печи", "[E] Felt boots by the stove"],
	&"sub.valenki_semenov": ["Валенки Семёнова сохнут у холодной печки. Значит, он вышел наружу налегке... и не планировал уходить.", "Semyonov's felt boots are drying by the cold stove. He stepped outside in light shoes... not intending to leave."],
	&"it.clock_stopped": ["[E] Часы «Ракета»", "[E] 'Raketa' clock"],
	&"sub.clock_stopped": ["Механические часы «Ракета». Завод кончился... стрелки застыли ровно в 03:12.", "Mechanical 'Raketa' clock. Spring unwound... hands stopped at exactly 03:12."],
	&"it.belomor": ["[E] Пачка «Беломорканал»", "[E] Pack of 'Belomorkanal'"],
	&"sub.belomor": ["Пачка «Беломорканала». Семёнов курил строго по часам, а последние папиросы так и остались целыми.", "Pack of Belomorkanal. Semyonov smoked on schedule, yet the last papirosi remain untouched."],
	&"it.spidola": ["[E] Приёмник «Спидола-232»", "[E] 'Spidola-232' radio"],
	&"sub.spidola": ["Батарейки 373 сели в ноль. Шкала застряла на длинных волнах в пустом эфире.", "Type 373 batteries completely drained. Dial stuck on longwave in empty ether."],
	&"it.tm1_log_desk": ["[E] Расписаться в журнале смен ТМ-1", "[E] Sign the TM-1 watch log"],
	&"sub.tm1_log_signed": ["Запись внесена: «14 ноября 1983 г., 21:30. Вахту принял дежурный техник В. Мальцев».", "Entry recorded: 'November 14, 1983, 21:30. Watch assumed by technician V. Mal'tsev'."],
	&"sub.match_strike": ["Чиркнул спичкой... сквозняк в ледяной избе задул огонёк. Пальцы сводит от стужи.", "Struck a match... a draft in the freezing cabin blew out the flame. Fingers numb from the cold."],
	&"sub.stove_lit_prologue": ["Вторая спичка взялась. Береста вспыхнула с сухим треском. Из чугунной буржуйки потянуло спасительным жаром.", "The second match caught. Birch bark flared with a dry crackle. Saving heat radiates from the cast-iron stove."],
	&"trail.signpost": ["МЕТЕОСТАНЦИЯ КЕДР-7 ➔", "KEDR-7 WEATHER STATION ➔"],
	&"driver.1": ["МИХАЛЫЧ: Ну, приехали. Кедр-7. Дальше только лес да мачта.", "MIKHALYCH: Well, here we are. Kedr-7. Nothing past this but forest and the mast."],
	&"driver.2": ["МИХАЛЫЧ: Сводки — в полночь и в два ночи. Приборы — на площадке и в корпусе, по верёвке от двери. Верёвку не отпускай.", "MIKHALYCH: Reports at midnight and at two. Instruments are on the plot and in the building, follow the rope from the door. Don't let go of the rope."],
	&"driver.3": ["МИХАЛЫЧ: Солярка в сарае ГСМ. Встанет генератор — света не будет. А без света тут... не надо без света.", "MIKHALYCH: Diesel is in the fuel shed. If the generator dies there's no light. And out here without light... just don't."],
	&"driver.4": ["МИХАЛЫЧ: Дрова — под лесопильным навесом, на южной поляне, по верёвке от крыльца. Печь держи, мороз под сорок.", "MIKHALYCH: Firewood is under the sawyer shed on the south clearing, follow the rope from the porch. Keep the stove going, it's near forty below."],
	&"driver.5": ["МИХАЛЫЧ: Семёнов журнал оставил. Почитай. Мужик был со странностями, но правила его соблюдай.", "MIKHALYCH: Semyonov left his log. Read it. Odd fellow, but follow his rules."],
	&"driver.6": ["МИХАЛЫЧ: Большая Земля на 6880. Отстучись для проверки — и до встречи через неделю.", "MIKHALYCH: The mainland is on 6880. Send a test report and I'll see you in a week."],
	&"driver.7": ["МИХАЛЫЧ: И это, Витя... Если ночью постучат — не открывай. Тут на сто сорок кэмэ никого.", "MIKHALYCH: And Vitya... if someone knocks at night, don't open. There's nobody for a hundred and forty kilometres."],
	&"day1.start": ["Ночью кто-то ходил вокруг дома. Михалыч говорил, вещи Семёнова сложены в сарае ГСМ.", "Something walked around the house last night. Mikhalych said Semyonov's things are in the fuel shed."],
	&"day2.start": ["На схеме станции появилась карандашная пометка: изба к западу от мачты. Семёнов ходил туда.", "A pencil mark has appeared on the station map: a hut west of the mast. Semyonov used to go there."],
	&"day1.goal": ["Найти вещи Семёнова в сарае ГСМ", "Find Semyonov's things in the fuel shed"],
	&"day2.goal": ["Сходить в избу (схема — M) и забрать то, что оставил Семёнов", "Go to the hut (map — M) and take what Semyonov left there"],
	&"day.rest": ["До темноты — подготовиться. Кровать — отдохнуть до вечера", "Prepare before dark. Use the bed to rest until evening"],
	&"n1.start": ["Сводка на 00:00. Метеоплощадка к северо-востоку от дома. Схема станции — M.", "Report due at 00:00. The weather yard is northeast of the house. Station map — M."],

