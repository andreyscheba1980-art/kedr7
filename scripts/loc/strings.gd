	&"sub.trunk_unpacked": ["Рундук распакован: запас радиоламп 6Ж1П, герметичные спички, пачка сухпая и журнал.", "Trunk unpacked: spare 6Zh1P tubes, sealed matches, dry rations, and station logbook."],
	&"sub.door_bolted": ["Засов задвинут. Снаружи остался только буран.", "Door bolted shut. Nothing left outside but the blizzard."],
	&"sub.roof_snow_thud": ["Глухой тяжелый удар над головой... Массивный пласт снега сорвался со ската крыши.", "A heavy, muffled thud overhead... A massive slab of snow slid off the pitched roof."],
	&"sub.bed_first_knock": ["Одиночный тяжелый стук снаружи в бревенчатую стену... будто рукавицей.", "A single, heavy knock on the outside log wall... as if from a thick mitten."],
