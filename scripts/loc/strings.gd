	&"decor.poster_1": ["ВЫХОДЯ В ПУРГУ —", "GOING OUT IN A BLIZZARD —"],
	&"decor.poster_2": ["ДЕРЖИСЬ ЛЕЕРА!", "HOLD THE ROPE!"],
	&"decor.poster_3": ["Отпустил трос — потерял дом.", "Let go of the rope — lose the house."],
	&"it.wall_map": ["[E] Карта района", "[E] Area map"],
	&"it.calendar": ["[E] Календарь", "[E] Calendar"],
	&"it.roster": ["[E] График дежурств", "[E] Duty roster"],
	&"it.family_photo": ["[E] Фотография", "[E] Photograph"],
	&"sub.calendar": ["Сегодня %d ноября. До конца вахты ночей: %d.", "Today is November %d. Nights left on watch: %d."],
	&"sub.calendar_foreign": ["Зачёркнуто и %d-е. Не карандашом — чем-то бурым. Ты его не зачёркивал.", "The %dth is crossed out too. Not in pencil — something brown. You didn't cross it out."],
	&"sub.roster": ["Семёнов вычеркнут жирно, до дыры в бумаге. Дальше — твоя фамилия, потом смена с Большой Земли.", "Semyonov is struck out hard, through the paper. Then your name, then the relief from the mainland."],
	&"sub.roster_late": ["Смены с Большой Земли в графике больше нет. Под твоей фамилией — снова твоя, бурым: «с 22-го». Без конца.", "The mainland relief is gone from the roster. Under your name — your name again, in brown: \"from the 22nd\". With no end date."],
	&"sub.family_photo": ["Мать с отцом у крыльца, 1971. На обороте: «Вернись к Новому году». Не вернулся.", "Mother and father on the porch, 1971. On the back: \"Come home for New Year.\" You didn't."],
