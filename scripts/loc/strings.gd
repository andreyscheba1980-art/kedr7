	&"sub.kerosene_lit": ["Фитиль вспыхнул ровным тёплым светом.", "The wick flared with a steady, warm glow."],
	&"it.window_wipe": ["[E] Протереть стекло от инея", "[E] Wipe frost from the glass"],
