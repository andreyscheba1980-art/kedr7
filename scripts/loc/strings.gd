	# --- Калибровка яркости ---
	&"calib.title": ["ЯРКОСТЬ", "BRIGHTNESS"],
	&"calib.hint": ["Двигай ползунок, пока левая ель не станет едва видна, а правая — не исчезнет совсем. Так ночь будет тёмной, но честной.", "Move the slider until the left spruce is barely visible and the right one disappears completely. The night will be dark, but fair."],
	&"calib.done": ["Готово", "Done"],
	&"calib.open": ["Калибровка яркости…", "Calibrate brightness…"],
	&"hint.obereg": ["Обереги у двери помогают, но у каждого своя цена. Соль на пороге — гость за дверью уходит быстрее (печь жрёт дрова). Нож в косяке — легче проснуться от сонного морока (рация шумит). Простыня на зеркале — никто не смотрит в окна (не видно инея). Блюдце домовому — раз за ночь.", "The wards by the door help, but each has a price. Salt on the threshold — whoever knocks leaves sooner (the stove eats more wood). Knife in the lintel — easier to wake from the sleep-haunt (the radio hisses). A sheet over the mirror — nothing watches through the windows (you won't see the frost). A saucer for the house spirit — once a night."],
	&"sub.barograph_dead": ["(барограф молчит — пружина кончилась или высохли чернила. Он ничего не скажет, пока не починишь.)", "(the barograph is silent — the spring ran down or the ink dried. It won't warn you until you fix it.)"],
	&"barograph.stopped": ["ПЕРО СТОИТ. Заведи пружину и проверь чернила.", "PEN STOPPED. Wind the spring and check the ink."],
	&"sub.salt_knock": ["(за дверью хрустнула соль — и шаги ушли с крыльца)", "(salt crunches beyond the door — and the steps leave the porch)"],
	&"hint.seismo": ["Сейсмоприёмник «Слухач» у стола: в наушниках слышно, с какой стороны и как близко Ырка. Глянь, прежде чем выходить.", "The \"Listener\" seismometer by the desk: in the headphones you can hear which side the Yrka is on and how close. Check it before you go out."],
	&"hud.saved": ["Сохранено: ночь продолжится отсюда", "Saved: the night will resume from here"],
	&"card.resumed": ["(после первой сводки)", "(after the first report)"],
	&"card.preparing": ["подготовка… %d%%", "preparing… %d%%"],
	&"rnd.trail": ["Следы. Босые, из леса — прямо к поленнице и дальше, под окно.", "Footprints. Bare feet, out of the forest — straight to the woodpile and on, under the window."],
	&"rnd.leak": ["Одна канистра пробита. Солярка ушла в снег — будто проткнули когтем.", "One fuel can is punctured. The diesel has soaked into the snow — as if pierced by a claw."],
	&"rnd.old_call": ["(в рации на миг пробился чужой голос — и пропал в шуме)", "(a stranger's voice broke through the radio for a moment — and sank into the noise)"],
	&"rnd.porch": ["На крыльце — рукавица Семёнова. Вечером её здесь не было.", "Semyonov's mitten lies on the porch. It wasn't here this evening."],
	&"rnd.stove_out": ["Печь погасла. Разом, будто задули.", "The stove went out. All at once, as if blown out."],
	&"sig.old_call.1": ["...Кедр-3 вызывает Кедр-7... приём...", "...Kedr-3 calling Kedr-7... over..."],
	&"sig.old_call.2": ["...сводка за четырнадцатое января шестьдесят первого... у нас тоже стучат...", "...report for the fourteenth of January, sixty-one... they knock here too..."],
	&"icp.title": ["ЖУРНАЛ ПЕРЕХВАТОВ", "INTERCEPT LOG"],
	&"icp.count": ["Поймано сигналов: %d из %d · кассет: %d · очищено: %d", "Signals caught: %d of %d · tapes: %d · cleaned: %d"],
	&"icp.hidden": ["???   где-то между %d и %d кГц", "???   somewhere between %d and %d kHz"],
	&"icp.hidden_any": ["???   появляется не каждую ночь", "???   doesn't appear every night"],
	&"icp.unknown_name": ["Неизвестный сигнал · %.0f кГц", "Unknown signal · %.0f kHz"],
	&"icp.taped": ["на плёнке", "on tape"],
	&"icp.cleaned": ["очищено", "cleaned"],
	&"icp.has_hidden": ["(под шумом что-то есть — запиши и почисти на магнитофоне)", "(something is under the noise — record it and clean it on the recorder)"],
	&"icp.close": ["J / E — закрыть", "J / E — close"],
	&"tasks.icp_hint": ["J — журнал перехватов", "J — intercept log"],
	&"tape.old_call": ["Кедр-3 · позывной 1961 года", "Kedr-3 · a 1961 callsign"],
	&"sub.fresh_tracks": ["Свежие следы на снегу... Босые. Их не было пару минут назад, когда я шёл сюда.", "Fresh footprints in the snow... Bare feet. They weren't here when I walked this way two minutes ago."],
	&"sub.distant_watcher": ["Там, у кедров, кто-то стоял... Или это просто сухостой в буране?", "Someone was standing by the cedars... Or was it just deadwood in the blizzard?"],
	&"sub.door_scratches": ["На досках двери — свежие борозды. Словно кто-то скрёб когтями, проверяя засов.", "Fresh gouges on the door planks. As if something clawed at them, testing the latch."],
	&"sub.frost_hand": ["На инее снаружи — след ладони. Пальцы неестественно длинные. Кто-то смотрел внутрь.", "On the frost outside — a palm print. The fingers are unnaturally long. Someone was looking in."],
	&"sub.teapot_moved": ["Чайник стоял на печи... Я точно помню, что не переставлял его на стол.", "The kettle was on the stove... I know for certain I didn't move it to the desk."],
	&"sub.phantom_breath": ["(холодный выдох прямо в затылок...)", "(a freezing exhale right behind my neck...)"],
	&"sub.roof_steps": ["(над головой, по крыше, кто-то медленно идёт. Тяжело. Доски прогибаются)", "(above you, on the roof, someone is walking slowly. Heavy. The boards give under it)"],
	&"sub.fever_meteo": ["Тридцать шесть и шесть... Откуда в закрытой промёрзшей будке живое тепло?!", "Thirty-six point six... How can there be body heat inside a frozen screen?!"],
	&"sub.door_ajar": ["Дверь была заперта. Сквозь щёлку надуло свежий снег...", "The door was latched. Fresh snow blew through the gap..."],
	&"sub.window_face": ["В окне... на долю секунды... лицо...", "In the window... for a fraction of a second... a face..."],

	# --- Новые объекты окружения (архитектурное обновление) ---
	&"it.storage_tubes": ["[E] Запасные радиолампы", "[E] Spare radio tubes"],
	&"sub.storage_tubes": ["Запасные лампы 6П3С и 6Ж1П в коробках. Семёнов берёг их как зеницу ока.", "Spare 6P3S and 6Zh1P vacuum tubes in boxes. Semyonov guarded them like treasure."],
	&"it.attic_hatch": ["Лаз на чердак. Верёвка свисает с засова.", "Attic hatch. A rope dangles from the latch."],
	&"it.snowmobile": ["[E] Зачехлённый снегоход", "[E] Covered snowmobile"],
	&"sub.snowmobile": ["Второй «Буран», на запчасти: двигатель разобран, магнето снято. Рабочий стоит у ворот.", "A second Buran, kept for parts: engine apart, magneto gone. The working one is by the gate."],
	&"it.axe_stump": ["[E] Топор в колоде", "[E] Axe in stump"],
	&"sub.axe_stump": ["Тяжёлый колун с расколотым топорищем. Лезвие глубоко засажено в смолистую лиственницу.", "A heavy splitting maul with a cracked haft. The blade is buried deep in pitchy larch."],
	&"it.old_meteo": ["[E] Старая метеобудка 1961 г.", "[E] Old 1961 weather screen"],
	&"sub.old_meteo": ["Серийный номер 014. Заброшена в шестьдесят первом. Внутри на стенке ножом выцарапано: «ОНИ СЛУШАЮТ».", "Serial number 014. Abandoned in sixty-one. Carved into the inner wall: \"THEY ARE LISTENING\"."],
	&"it.transformer": ["[E] Трансформаторный щит", "[E] Transformer cabinet"],
	&"sub.transformer": ["Табличка со стрелой: «НЕ ВЛЕЗАЙ — УБЬЕТ!». Внутри гудит высокое напряжение антенного контура.", "Warning plaque with a lightning bolt: \"DO NOT TOUCH — LETHAL DANGER!\". High voltage hums inside the antenna circuit."],
	&"it.kung_cabin": ["[E] Бытовка дорожников", "[E] Road maintenance trailer"],
	&"sub.kung_cabin": ["Вагончик дорожных рабочих на полозьях. Завален снегом до середины окон. Внутри пусто и промёрзло.", "A maintenance wagon on skids. Snowdrifts reach halfway up the windows. Empty and frozen solid inside."],
	&"it.cellar_hole": ["[E] Подпол", "[E] Cellar hole"],
	&"sub.cellar_hole": ["Тёмный провал под полом. Тянет сырой мёрзлой землёй и тишиной. Спускаться туда нет никакого желания.", "A dark void under the floorboards. Smells of damp frozen earth and silence. You have no desire to climb down there."],
	&"it.frozen_nets": ["[E] Мёрзлые сети", "[E] Frozen nets"],
	&"sub.frozen_nets": ["Рыболовные сети покрыты ледяной коркой. В буран запутаться в них — верная смерть.", "Fishing nets crusted in ice. Tangling in them during a blizzard would be certain death."],
	&"it.blast_door": ["Гермодверь убежища. Запорный штурвал заклинен в открытом положении.", "Shelter blast door. The handwheel lock is wedged in the open position."],
	&"sub.figure_trees": ["В темноте между деревьями кто-то стоял... и отступил вглубь леса.", "Someone was standing in the dark between the trees... and retreated deeper into the woods."],
	&"sub.noon_fades": ["Белая фигура в сугробах растаяла в метели...", "The white figure in the snowdrifts melted into the blizzard..."],
	&"sub.shadow_watching": ["Из темноты кто-то неподвижно следит за станцией.", "Someone is watching the station motionless from the darkness."],
	&"sub.mimic_turn": ["Фигура в буране... ОНО ПОВЕРНУЛО ГОЛОВУ НАЗАД!", "A figure in the blizzard... IT TURNED ITS HEAD BACKWARDS!"],
	&"sub.flash_flicker": ["Фонарик затрещал и погас... В темноте прямо на меня кто-то бежит!", "The flashlight buzzed and died... Someone is sprinting straight at me in the dark!"],
	&"sub.eyes_taiga": ["В чаще горят глаза... Немигающие зрачки следят из темноты.", "Eyes glowing in the thicket... Unblinking pupils watching from the dark."],
	&"sub.whisper_taiga": ["(сквозь вой бурана из чащи — хриплый шёпот. Слов не разобрать.)", "(through the howling blizzard, a raspy whisper from the trees. The words won't come clear.)"],
	&"sub.zherdyai_close": ["Над макушками деревьев качнулся трёхметровый силуэт...", "A ten-foot silhouette swayed above the tree crowns..."],
	&"sub.yrka_slash": ["Острые когти вспороли тулуп! Скорее в укрытие, пока он не набросился снова!", "Sharp claws tore through your coat! Run for shelter before it lunges again!"],
	&"sub.yrka_stalk": ["(сзади в метели раздался низкий утробный рык... ОНО РЯДОМ!)", "(a low feral snarl echoes in the blizzard behind you... IT'S CLOSE!)"],
	&"sub.lake_flares": ["Под сухими сетями на верстаке — коробка сигнальных ракет. Две штуки, в запас.", "Under the dry nets on the workbench: a box of flares. Two more in reserve."],
	&"sub.mast_emergency": ["(в рации треск) Антенный контур замкнуло из-за наледи на мачте! Нужно сбить лёд у основания мачты.", "(radio crackles) Antenna circuit shorted due to mast icing! Clear the ice at the mast base."],
	&"sub.shed_fuel_needed": ["Топливо в генераторе на исходе. Нужно сходить на склад ГСМ за резервной канистрой!", "Generator fuel is running low. Need to run to the fuel shed for a reserve canister!"],

	# --- Замёрзший охотник и динамические сущности ---
	&"it.frozen_hunter": ["[E] Осмотреть замёрзшего охотника", "[E] Inspect frozen hunter"],
	&"sub.hunter_pose_0": ["Охотник привалился к вековой ели. Ружьё ИЖ-58 лежит на коленях, снег на плечах. Он мёртв уже не один день.", "The hunter slumps against the ancient spruce. IZh-58 rifle across his knees, snow dusting shoulders. Dead for days."],
	&"sub.hunter_pose_1": ["Поза изменилась... Голова приподнята, пальцы крепко сжали цевьё ружья. Но на снегу вокруг нет свежих следов.", "The posture has shifted... Head tilted up, fingers gripping the rifle stock. Yet no fresh tracks around in the snow."],
	&"sub.hunter_pose_2": ["Он накренился вперёд, будто пытается встать и пойти к станции... Рука указывает в сторону тропы.", "He is leaning forward, as if trying to rise toward the station... Hand pointing along the trail."],
	&"sub.hunter_pose_3": ["Под елью пусто! Только лыжные палки в сугробе и оборванный ремень. Цепочка глубоких следов ведёт к дому...", "Empty under the spruce! Only ski poles in the snowdrift and a torn strap. Deep tracks lead toward the station..."],
	&"it.hunter_note": ["[E] Прочесть берестяную грамоту", "[E] Read birch bark note"],
	&"note.hunter": ["«...245° на радиопеленгаторе. Если собьёшься с вешек — крути верньер на старый маяк. В метель не оборачивайся. Ырка окликает чужими голосами...»", "\"...245° on the direction finder. If you lose the stakes, dial the tuner to the old beacon. In the blizzard do not turn around. Yrka calls out in voices of those you know...\""],
	&"it.hunter_compass": ["[E] Забрать компас охотника", "[E] Take hunter's compass"],
	&"sub.hunter_compass": ["Старый армейский компас Адрианова. Стрелка замерла, указывая точно на юго-запад.", "An old Adrianov military compass. The needle is frozen, pointing steady to the southwest."],
	&"it.hunter_tracks": ["[E] Осмотреть пустое место и следы", "[E] Inspect empty spot and tracks"],
	&"sub.hunter_aura": ["Ветер вокруг вековой ели внезапно стих. Мёртвая, неестественная тишина...", "The wind around the ancient spruce abruptly died down. A dead, unnatural stillness..."],
	&"sub.zherdyai_window": ["В окне... Трёхметровая фигура в изодранном ватнике метеоролога наклонилась к стеклу. На мёртвом запястье тускло блестят командирские часы.", "At the window... A ten-foot figure in a tattered observer coat bends down to the glass. Commander's watch gleams dully on a frozen wrist."],
	&"sub.obmiralo_counter_success": ["«Сосна-четыре»... За дверью раздаётся скрежет когтей о брёвна. Тяжёлые шаги удаляются в метель.", "\"Pine-Four\"... Behind the door, claws scrape against the logs. Heavy steps retreat into the blizzard."],
	&"sub.polunochnitsa_glimpse": ["В отражении за твоим плечом мелькнули длинные чёрные пряди... Но в комнате никого нет.", "In the reflection behind your shoulder, long black tresses swayed... But the room is empty."],

	# --- Механика тяжести, поленница и станция ---
	&"sub.hands_busy_crank": ["Обе руки заняты! Сбрось груз [G], чтобы крутить фонарь.", "Both hands are busy! Drop cargo [G] to crank flashlight."],
	&"sub.dropped_item": ["Сбросил груз в снег.", "Dropped cargo into the snow."],
	&"it.woodbox": ["[E] Дровница (%d/3)", "[E] Firewood box (%d/3)"],
	&"it.woodbox_add": ["[E] Положить полено в дровницу (%d/3)", "[E] Put log into box (%d/3)"],
	&"it.woodbox_take": ["[E] Взять полено из дровницы (%d/3)", "[E] Take log from box (%d/3)"],
	&"it.woodbox_full": ["Дровница полна", "Firewood box is full"],
	&"it.woodbox_empty": ["В дровнице пусто", "Firewood box is empty"],
	&"sub.woodbox_add": ["Положил сухое полено в запас к печи.", "Stacked a dry log into the stove reserve."],
	&"sub.woodbox_take": ["Взял сухое полено из запаса.", "Took a dry log from the reserve."],
	&"it.kettle": ["[E] Закипающий чайник на печи", "[E] Boiling kettle on stove"],
	&"sub.kettle_drink": ["Горячий крепкий чай разливается теплом по телу (+15 к теплу).", "Scalding strong tea warms you to the core (+15 warmth)."],
	&"it.sawhorse": ["[E] Распиловочные козлы", "[E] Sawyer buck"],
	&"sub.sawhorse": ["Старые дощатые козлы с ржавой двуручной пилой. Свежих опилок нет уже много месяцев.", "Old wooden buck with a rusty crosscut saw. No fresh sawdust for months."],
	&"it.silhouette_stump": ["[E] Мёрзлый корявый пень", "[E] Frozen twisted stump"],
	&"sub.silhouette_stump": ["Обледенелый пень с расщеплёнными сучьями. В метели показалось, что это стоял человек.", "An icy stump with split branches. In the blizzard it looked like someone standing there."],
	&"sub.woodpile_frozen": ["Дрова примёрзли! Удерживай [E], чтобы отодрать...", "The logs are frozen stuck! Hold [E] to pry loose..."],
	&"sub.voice_blizzard": ["(сквозь вой бурана голос) ...Кедр-семь... слышишь?.. пусти... дверь...", "(through the storm a voice calls) ...Kedr-7... hear me?.. let me in... the door..."],
	&"sub.window_thud": ["Глухой удар в стекло радиорубки снаружи!", "A heavy thud against the radio room window outside!"],
	&"sub.beacon_blackout": ["Маяк на крыше станции с треском погас! Темнота...", "The station roof beacon sputtered and died! Pitch black..."],
	&"sub.crow_startle": ["Из занесённой снегом кроны с диким криком сорвался ворон!", "A raven burst from the snow-laden boughs with a furious shriek!"],
	&"sub.teapot_cold": ["Печь погасла — чайник ледяной.", "The stove is out — the kettle is freezing cold."],
	&"sub.kettle_recent": ["Только что пил горячий чай. Больше пока не хочется.", "Just drank hot tea. Don't need any more for now."],

	# --- Этап 3: Ночные аварии и выходы на мороз ---
	&"sub.chimney_iced": ["Тяга пропала! Дым валит из печи в комнату... оголовок трубы забило наледью!", "Draft lost! Smoke pouring into the room... chimney pipe frozen shut!"],
	&"sub.chimney_cleared": ["Пробил ледяную пробку! Тяга вернулась со свистом, дым уходит в трубу.", "Broke the ice plug! The draft returned with a rush, smoke clears out."],
	&"it.chimney": ["Дымоход печи — тяга чистая", "Stove chimney — clear draft"],
	&"it.chimney_iced": ["[E] Сбить наросшую наледь с дымохода", "[E] Knock ice plug off the chimney pipe"],
	&"sub.fuel_sputter": ["Дизель задыхается — арктическая солярка парафинится на морозе! Нужно прокачать фильтр в сарае ГСМ!", "Diesel engine choking — arctic fuel gelling in the frost! Bleed the filter in the fuel shed!"],
	&"sub.fuel_restored": ["Топливопровод прокачан. Дизель снова мерно гудит, свет горит ровно.", "Fuel line cleared. Diesel hums steadily again, light is stable."],
	&"it.fuel_bleed": ["[E держать] Прокачать топливопровод и слить парафин", "[hold E] Bleed fuel line and clear wax"],
	&"it.fuel_valve": ["Топливный кран и центрифуга в норме", "Fuel valve and filter nominal"],
	&"sub.anemo_iced": ["Стрелка на пульте замерла на нуле! Датчик ветра на крыше корпуса обмёрз.", "The panel needle is stuck at zero! The wind sensor on the building roof has iced up."],
	&"sub.anemo_cleared": ["Сбил корку льда. Чашки закрутились на ветру, прибор в доме снова пишет показания.", "Knocked off the ice crust. Cups spinning in the wind, meter indoors recording again."],
	&"it.vane_ice": ["[E] Сбить наледь с чашек флюгера-анемометра", "[E] Knock ice off the anemometer cups"],
	&"it.vane_ok": ["Флюгер Вильда и чашечный анемометр — вращаются свободно", "Wild vane and cup anemometer — rotating freely"],

	# --- Этап 4: Психологический хоррор и тонкие скримеры ---
	&"sub.peephole_stare": ["В дверном глазке... белое неподвижное глазное яблоко... Оно смотрит прямо на тебя.", "In the peephole... a white unblinking eyeball... staring directly back at you."],
	&"sub.semenov_inside": ["ГОЛОС СЕМЁНОВА (из тёмного коридора за твоей спиной): «Витя... открой ему. Он не уйдёт».", "SEMYONOV'S VOICE (from the dark corridor behind you): \"Vitya... let him in. He won't leave\"."],
	&"sub.window_reflection": ["В отражении ночного стекла... за твоим плечом кто-то стоит.", "In the reflection of the night glass... someone is standing right behind your shoulder."],
	&"sub.thawed_footprints": ["На полу коридора — подтаявшие следы босых ног от входной двери к столу с рацией...", "On the corridor floor — thawed barefoot prints leading from the front door straight to the radio desk..."],
	&"sig.alone": ["...Внимание постам... На Кедр-7 Виктор находится один... Повторяю, второй оператор не выходил на связь...", "...Attention all posts... On Kedr-7 Viktor is alone... Repeating, second operator never checked in..."],

	# --- Этап 5: Советский антураж 1983 года и физический холод ---
	&"it.podstakannik": ["[E] Отпить горячего чая из подстаканника", "[E] Sip hot tea from the podstakannik"],
	&"sub.tea_drunk": ["Горячий индийский чай согревает изнутри. Дрожь в руках утихла.", "Hot Indian tea warms from within. Hand shivering subsides."],
	&"it.clock": ["Настенные часы Сердобского завода «Янтарь». Маятник мерно отсчитывает секунды.", "Soviet Serdobsk 'Yantar' clock. Pendulum rhythmically marks the seconds."],
	&"it.valenki": ["Сушатся войлочные валенки у чугунной печки. Пахнет овечьей шерстью и берёзовым дымом.", "Felt valenki drying by the cast-iron stove. Smells of sheep's wool and birch smoke."],
	&"obj.chimney": ["Дымоход забит наледью — сбить лёд у западной стены дома (держать E) или дать печи погаснуть", "The chimney is iced up — knock the ice off by the west wall (hold E) or let the stove go out"],
	&"obj.fuel_sputter": ["Дизель задыхается — прокачать топливный кран в сарае ГСМ (держать E)", "The diesel is choking — bleed the fuel valve in the fuel shed (hold E)"],
	&"obj.anemo": ["Датчик ветра на крыше корпуса обмёрз — подняться по лестнице, сбить лёд, потом снять ветер на пульте", "The wind sensor on the building roof is iced — climb the ladder, knock it off, then read the wind on the panel"],
	&"tasks.alarms": ["АВАРИИ:", "FAULTS:"],
	&"it.thawed_footprints": ["[E] Мокрые следы на полу", "[E] Wet footprints on the floor"],
	&"yrka.voice.1": ["Витя... постой...", "Vitya... wait..."],
	&"yrka.voice.2": ["Обернись... я здесь...", "Turn around... I'm here..."],
	&"yrka.voice.3": ["Пальцы примёрзли... помоги мне...", "My fingers are frozen... help me..."],
	&"yrka.voice.4": ["Куда ты уходишь... не бросай...", "Where are you going... don't leave me..."],
	&"yrka.dont_run": ["Ты побежал — и оно сорвалось следом!", "You ran — and it lunged after you!"],
	&"yrka.lesson": ["Обернулся... В упор — морда. И пропала. Семёнов писал: не оборачивайся и не беги.", "You turned... A face, right there. Then gone. Semyonov wrote: don't turn around, don't run."],
	&"yrka.contact_flare": ["ОНО В УПОР! Фонарь погас — ракету (V) или включи фонарь (F) в морду!", "IT'S RIGHT HERE! The light died — a flare (V), or the flashlight (F) in its face!"],
	&"yrka.contact_light": ["ОНО В УПОР! Фонарь погас — включи (F) и держи в морду!", "IT'S RIGHT HERE! The light died — switch it on (F) and hold it in its face!"],
	&"yrka.roof_saved": ["Крыша над головой. Оно не войдёт.", "A roof overhead. It won't come in."],
	&"sub.tea_cold": ["Чай остыл — печь не топится.", "The tea has gone cold — the stove is out."],
	&"sub.kettle_table": ["Чайник почему-то на столе. Холодный. Я его сюда не ставил.", "The kettle is on the table for some reason. Cold. I didn't put it here."],
	&"radio.wait_voice": ["В эфире говорят — дождись тишины.", "Someone is talking on the air — wait for silence."],
	&"tape.alone": ["Сводка «Один» · 5210 кГц", "\"Alone\" bulletin · 5210 kHz"],
	&"it.lake_flares": ["[E] Коробка сигнальных ракет", "[E] Box of flares"],
	&"sub.dusk_goal": ["Темнеет, а дело дня не сделано. Солнце подождёт, мороз — нет.", "It's getting dark and the day's job isn't done. The sun can wait; the frost won't."],
	&"death.retry_day": ["[ клик — начать день заново ]", "[ click to try the day again ]"],
	&"sub.zimnik_wait": ["Зимник ведёт на Большую Землю. Но смена ещё идёт — дождись последней связи.", "The winter road leads to the mainland. But the shift isn't over — wait for the last call."],
	&"sub.chest_empty": ["В сундуке пусто — только старые карты и моль.", "The chest is empty — just old maps and moths."],
	&"radio.why_silent": ["— Кедр-7, Кедр-7... Почему молчите? Ответьте, Кедр-7. (Сводка просрочена.)", "— Kedr-7, Kedr-7... Why are you silent? Respond, Kedr-7. (The report is overdue.)"],
	&"radio.reports_closed": ["03:00. Несданные сводки сорваны. Теперь Большой Земле не отвечай.", "03:00. Unsent reports are lost. Don't answer the mainland now."],
	&"radio.too_early": ["Рано. Сводку на %s принимают с %s.", "Too early. The %s report is accepted from %s."],
	&"obj.door_open": ["Входная дверь открыта — закрой её", "The front door is open — shut it"],
	&"it.stove_douse": ["[E] Залить печь (дымоход забит — угар)", "[E] Douse the stove (chimney blocked — fumes)"],
	&"sub.stove_doused": ["Залил печь. Шипит, пар. Угар не пойдёт, но дом начнёт остывать.", "You douse the stove. Hiss and steam. No more fumes, but the house will start to cool."],
	&"bc.st_sosna_1": ["СОСНА-2: ...для Большой Земли. Минус двадцать восемь, ветер северный, пять метров. Видимость — два километра. Конец.", "SOSNA-2: ...to the mainland. Minus twenty-eight, wind north, five metres. Visibility two kilometres. Over."],
	&"bc.st_bereza_1": ["БЕРЁЗА-5: ...сводку принимайте. Минус тридцать три, тихо, ясно. У нас всё спокойно.", "BEREZA-5: ...take the report. Minus thirty-three, calm, clear. All quiet here."],
	&"bc.st_sosna_2": ["СОСНА-2: ...минус тридцать... Большая Земля, у нас кто-то ходит вокруг вышки. Смена к нам не выезжала?", "SOSNA-2: ...minus thirty... Mainland, someone is walking around our tower. Did you send a relief out to us?"],
	&"bc.st_bereza_2": ["БЕРЁЗА-5: ...Большая Земля, не слышу вас третий час. Кто-нибудь... кто-нибудь на приёме?", "BEREZA-5: ...Mainland, I haven't heard you for three hours. Anyone... is anyone receiving?"],
	&"bc.st_sosna_3": ["СОСНА-2: Минус двадцать восемь. Ветер северный. Пять метров. (слово в слово, как в первую ночь)", "SOSNA-2: Minus twenty-eight. Wind north. Five metres. (word for word, like the first night)"],
	&"bc.st_kedr7_fake": ["КЕДР-7: ...для Большой Земли. Минус тридцать один, ветер северо-западный. Оператор Лазарев. Всё спокойно. (Ты ничего не передавал.)", "KEDR-7: ...to the mainland. Minus thirty-one, wind north-west. Operator Lazarev. All quiet. (You transmitted nothing.)"],
	&"bc.sem_log_1": ["СЕМЁНОВ: Запись первая. Заступил. Тайга, мачта, тишина. Михалыч на прощание сказал — двери не открывай. Смешной.", "SEMYONOV: Entry one. On duty. Taiga, mast, silence. Mikhalych said as he left — don't open the door. Funny guy."],
	&"bc.sem_log_2": ["СЕМЁНОВ: Запись вторая. Ночью стучали. Три раза, пауза, три раза. Не открыл. Утром у крыльца следы — босые. Мороз сорок.", "SEMYONOV: Entry two. Knocking last night. Three, a pause, three. I didn't open. In the morning, footprints by the porch — barefoot. Forty below."],
	&"bc.sem_log_3": ["СЕМЁНОВ: Запись третья. В эфире цифры. Это не цифры — буквы. Шифровка. Таблица нашлась в ящике шестьдесят первого года.", "SEMYONOV: Entry three. Numbers on the air. They're not numbers — letters. A cipher. The table was in a box from sixty-one."],
	&"bc.sem_log_4": ["СЕМЁНОВ: Запись четвёртая. Большая Земля после трёх отвечает другим голосом. Он знает, как меня зовут. Он знает, как зовут мою жену.", "SEMYONOV: Entry four. After three the mainland answers in another voice. It knows my name. It knows my wife's name."],
	&"bc.sem_log_5": ["СЕМЁНОВ: Запись пятая. Под станцией что-то есть. Люк, лестница, гул. Сводки уходят не наверх. Они уходят вниз. Я спущусь.", "SEMYONOV: Entry five. There's something under the station. A hatch, a ladder, a hum. The reports don't go up. They go down. I'm going down."],
	&"bc.sem_log_6": ["СЕМЁНОВ: Сменщик. Если слышишь — ты тоже здесь давно. Не отвечай после трёх. И не оборачивайся. Я обернулся.", "SEMYONOV: Relief. If you can hear this, you've been here a long time too. Don't answer after three. And don't turn around. I turned around."],
	&"tape.bc_st_1": ["Сосна-2, ночь 1 · 7140 кГц", "Sosna-2, night 1 · 7140 kHz"],
	&"tape.bc_st_2": ["Берёза-5, ночь 2 · 7140 кГц", "Bereza-5, night 2 · 7140 kHz"],
	&"tape.bc_st_3": ["Сосна-2, ночь 3 · 7140 кГц", "Sosna-2, night 3 · 7140 kHz"],
	&"tape.bc_st_4": ["Берёза-5, ночь 4 · 7140 кГц", "Bereza-5, night 4 · 7140 kHz"],
	&"tape.bc_st_5": ["Сосна-2, ночь 5 · 7140 кГц", "Sosna-2, night 5 · 7140 kHz"],
	&"tape.bc_st_6": ["«Кедр-7», ночь 6 · 7140 кГц", "\"Kedr-7\", night 6 · 7140 kHz"],
