	&"it.window_tracks": ["[E] Осмотреть следы под окном", "[E] Inspect tracks under the window"],
	&"sub.window_tracks": ["Глубокие борозды на брёвнах и отпечатки босых ног на насте... Кто-то стоял здесь и смотрел прямо в окно рубки.", "Deep claw gouges in the logs and bare footprints in the crust... Someone stood here, staring right into the radio room window."],
	&"it.kerosene_lamp_on": ["[E] Зажечь керосиновую лампу", "[E] Light the kerosene lamp"],
