	# --- Замерзание замков, чайник и паяльная лампа ---
	&"it.frozen_padlock": ["[E] Обледеневший замок ангара (куржак и лёд)", "[E] Frozen shed padlock (ice and rime)"],
	&"sub.padlock_frozen": ["Замок намертво схвачен льдом. Нужен пар из кипящего чайника или огонь паяльной лампы.", "The padlock is frozen solid. Needs steam from a boiling kettle or a blowtorch flame."],
	&"sub.padlock_thawed_kettle": ["Струя пара и кипяток растопили лёд. Замок со щелчком поддался!", "Steam and boiling water melted the ice. The padlock clicked open!"],
	&"sub.padlock_thawed_torch": ["Гудящее пламя паяльной лампы мгновенно сожгло ледяную корку. Замок открыт!", "The roaring blowtorch flame burned away the ice in seconds. Padlock unlocked!"],
	&"it.blowtorch": ["[E] Взять паяльную лампу", "[E] Take blowtorch"],
	&"sub.got_blowtorch": ["Советская бензиновая паяльная лампа. Горячее синее пламя отогреет любой замёрзший металл.", "Soviet gasoline blowtorch. Its hot blue flame will thaw any frozen metal."],
	&"it.kettle_take": ["[F] Взять горячий чайник", "[F] Take hot kettle"],
	&"it.kettle_return": ["[E] Поставить чайник обратно на плиту", "[E] Put kettle back on stove"],
	&"sub.kettle_taken": ["Горячий чайник снят с печи. Пар валит из носика — на морозе остынет за минуту.", "Hot kettle taken from stove. Steam billows from the spout — will cool in a minute outside."],
	&"sub.kettle_cold_now": ["Чайник на морозе остыл и покрылся инеем.", "The kettle has cooled down and frosted over in the freezing air."],

	# --- Фотолаборатория и спутник «Метеор-2» ---
	&"it.darkroom": ["[E] Фотолаборатория (увеличитель «Ленинград-4»)", "[E] Darkroom (enlarger «Leningrad-4»)"],
	&"darkroom.title": ["ФОТОЛАБОРАТОРИЯ «ЛЕНИНГРАД-4»", "DARKROOM «LENINGRAD-4»"],
	&"darkroom.sub": ["Проявка фотоотпечатков под неактиничным красным светом", "Photographic print processing under red safelight"],
	&"darkroom.tray_dev": ["КЮВЕТА 1: ПРОЯВИТЕЛЬ СТ-1", "TRAY 1: DEVELOPER ST-1"],
	&"darkroom.tray_stop": ["КЮВЕТА 2: СТОП-ВАННА (1% УКСУС)", "TRAY 2: STOP BATH (1% ACETIC)"],
	&"darkroom.tray_fix": ["КЮВЕТА 3: КИСЛЫЙ ФИКСАЖ БКФ-2", "TRAY 3: ACID FIXER BKF-2"],
	&"darkroom.loupe_hint": ["[ЛКМ / E] Лупа: изучить скрытые детали отпечатка", "[LMB / E] Loupe: inspect hidden photographic details"],
	&"darkroom.loupe_active": ["Осмотр под 8-кратной лупой: видны микродетали зерна эмульсии", "Inspecting under 8x optical loupe: emulsion grain details visible"],
	&"darkroom.semenov_film": ["Архивная плёнка Семёнова №3 (найдена на станции)", "Semyonov's archive roll #3 (recovered at station)"],

	# --- Стенограмма вахтенного журнала ТМ-1 ---
	&"sub.journal_prophecy_seen": ["В журнале... записи наперёд. Сделанные твоим почерком.", "In the log... entries written ahead of time. In your own handwriting."],
	&"tm1.prophecy_title": ["ПРЕДВАРИТЕЛЬНЫЕ ЗАПИСИ СМЕНЫ (ПОЧЕРК МАЛЬЦЕВА)", "ADVANCE SHIFT ENTRIES (MALTSEV'S HANDWRITING)"],
	&"tm1.prophecy_1": ["23:40 — Стекло барографа треснет само по себе. Не трогай осколки голыми руками.", "23:40 — The barograph glass will crack on its own. Do not touch the shards with bare hands."],
	&"tm1.prophecy_2": ["02:15 — Не смотри на леер, когда он натянется струной над снегом. Там никого нет.", "02:15 — Do not look at the safety rope when it pulls taut above the snow. No one is there."],
	&"tm1.prophecy_3": ["04:10 — Кто-то откроет форточку изнутри аппаратной. Закрой её молча и не оглядывайся.", "04:10 — Someone will unlatch the casement window from inside the radio room. Close it silently and do not look back."],

	# --- Утренний осмотр последствий ночи («Night Aftermath») ---
	&"it.footprints": ["[E] Осмотреть босые следы", "[E] Inspect barefoot tracks"],
	&"sub.aftermath_footprints": ["Глубокие босые отпечатки на свежем насте. Пальцы неестественно скрючены, кожа была обморожена дочерна. Следы огибают крыльцо и уходят под дом.", "Deep barefoot prints in the fresh crust. The toes are unnaturally clawed, skin blackened by frostbite. The trail skirts the porch and leads beneath the house."],
	&"it.repair_window": ["[Зажать E] Заколотить выбитое окно фанерой", "[Hold E] Board up shattered window with plywood"],
	&"sub.window_repaired": ["Оконный проем надежно забит фанерой и пробит четырьмя гвоздями. Сквозняк прекратился.", "Window frame secured with plywood and four corner nails. The freezing draft stops."],
	&"it.gen_drain": ["[Зажать E] Слить замерзший конденсат из фильтра дизеля", "[Hold E] Drain frozen condensate from diesel filter"],
	&"sub.gen_drained": ["Отстойник фильтра очищен от ледяной эмульсии. Дизель работает ровно.", "Filter trap cleared of icy fuel slush. Diesel runs smoothly."],
	&"it.tighten_guywire": ["[Зажать E] Подтянуть ослабший талреп оттяжки мачты", "[Hold E] Tighten slack turnbuckle on mast guy wire"],
	&"sub.guywire_tightened": ["Стальной трос оттяжки натянут до струнного звона. Мачта больше не раскачивается от ветра.", "Steel guy wire tensioned tight as a harp string. The mast stops wobbling in the wind."],
	&"it.clear_chimney": ["[Зажать E] Сбить ледяную пробку с оголовка печи", "[Hold E] Knock ice blockage off stove pipe crown"],
	&"it.frozen_crow": ["[E] Осмотреть замерзшего ворона", "[E] Inspect frozen raven"],
	&"sub.aftermath_crow": ["Обледеневший черный ворон на ступенях. Шея неестественно вывернута на 180 градусов, глаза выклеваны изнутри.", "An iced black raven on the steps. Its neck is twisted 180 degrees, eyes hollowed from within."],
	&"it.scratches_wall": ["[E] Осмотреть борозды на бревнах", "[E] Inspect gouges on log wall"],
	&"sub.aftermath_scratches": ["Пять глубоких параллельных борозд на просмоленной сосне. Будто кто-то скребся когтями всю ночь, пытаясь достать до форточки.", "Five deep parallel gouges cut into the tarred pine logs. As if something clawed at the wood all night trying to reach the transom."],
	&"it.splice_rope": ["[Зажать E] Сплести разорванный леер безопасности", "[Hold E] Splice torn safety rope"],
	&"sub.rope_spliced": ["Пеньковый канат сплетен морским узлом и закреплен карабином. Трасса безопасна.", "Hemp rope spliced with a sheet bend and clipped with carabiner. Trail is secured."],
	&"sub.radio_call_incoming": ["[Зуммер Р-250] Внимание: входящий вызов на рабочей частоте! Большая Земля вызывает «Кедр-7».", "[R-250 Buzzer] Attention: incoming call on operating frequency! Mainland calling Kedr-7."],
	&"it.answer_call": ["[E] Ответить на утренний вызов Большой Земли", "[E] Answer morning call from Mainland"],

	# --- Утренние радиограммы Большой Земли (14:15) ---
	&"dispatch.day_1": ["«Кедр-7», это Свердловск-Контроль. Первый день дежурства принят. К вечеру ждем усиление ветра до 18 м/с, температура -34°C. Проверьте оттяжки мачты и запасы дров. На вашей частоте ночью фиксировали странные гармоники. У вас всё в порядке?", "'Kedr-7', this is Sverdlovsk Control. First duty day acknowledged. Expect wind gusts up to 18 m/s by dusk, temp -34°C. Check your mast guy wires and firewood stockpile. Night monitors logged odd harmonics on your frequency. Everything quiet out there?"],
	&"dispatch.day_2": ["«Кедр-7», радиосеанс 14:15. Синоптики передают подход арктического фронта. К ночи падение давления на 12 миллибар, буран нулевой видимости. Геологи Белова с «Таёжной-4» не вышли на контрольный сеанс в 12:00. Будьте предельно осторожны у кромки леса.", "'Kedr-7', 14:15 radio check. Forecasters report incoming Arctic front. Expect 12 mb pressure drop by nightfall, zero-visibility blizzard. Belov's geology party at Tayozhnaya-4 missed their 12:00 scheduled check-in. Exercise extreme caution near the tree line."],
	&"dispatch.day_3": ["«Кедр-7», вас слышим с помехами. Температура ночью упадет до -41°C. Не покидайте радиус лееров станции. Центр сообщает: на южном склоне Отортена зафиксированы сейсмические микротолчки искусственного спектра. Держите рацию на приеме.", "'Kedr-7', receiving you through heavy static. Temp tonight dropping to -41°C. Do not leave station safety rope radius. Center reports synthetic-spectrum seismic micro-shocks logged on Otorten's south slope. Keep your radio receiver live."],
	&"dispatch.day_4": ["«Кедр-7», экстренная сводка погоды: барометрический минимум за 30 лет. Штормовое предупреждение высшей категории. Ночью дежурному наблюдателю с постов не сходить. Свердловск перехватил посторонний радиосигнал на вашей закрытой частоте. Тот же голос, что у вас. Подтвердите пароль.", "'Kedr-7', urgent synoptic bulletin: lowest barometric pressure in 30 years. Maximum storm warning. Night observer must not step away from station posts. Sverdlovsk intercepted an unknown transmission on your private band. It sounded with your exact voice. Confirm countersign."],
	&"dispatch.day_5": ["«Кедр-7»... сквозь буран пробиться трудно. Вертолет снабжения из Ивделя застрял на перевале из-за обледенения. Вы остаетесь на автономном ресурсе еще на 48 часов. Берегите солярку. И... Виктор, не верьте голосам в эфире, если они не знают позывной.", "'Kedr-7'... signal breaking through the blizzard. Supply chopper from Ivdel grounded at pass due to icing. You remain on autonomous reserves for another 48 hours. Conserve diesel fuel. And... Victor, trust no voices on the air that don't know our countersign."],
	&"dispatch.day_6": ["«Кедр-7»! Мы потеряли сигнал соседней станции «Берёза-1»... Тишина во всех диапазонах. В тайге объявлена зона чрезвычайного положения. Если увидите чужие следы у дверей — заприте засов и не открывайте ни при каких обстоятельствах. Мы пытаемся пробить дорогу наземным транспортом.", "'Kedr-7'! We lost all carrier signals from neighboring station 'Beryoza-1'... Pure silence across all wavebands. Taiga sector placed under emergency quarantine. If you see stranger tracks at your doorstep — throw the bolt and open to no one. We are trying to push ground vehicles through."],

	# --- Вторичные точки интереса тайги (10 POI) ---
	&"it.poi_buran_engine": ["[E] Осмотреть двигатель снегохода «Буран»", "[E] Inspect 'Buran' snowmobile engine"],
	&"sub.buran_plug_found": ["Под капотом замерзшего «Бурана» найдена запасная калильная свеча зажигания в промасленной бумаге. Новая свеча: «Буран» и дизель корпуса теперь заводятся с первого рывка.", "Under the frozen Buran's cowl, a spare glow plug in oiled paper was salvaged. A fresh plug: the Buran and the building diesel now start on the first pull."],
	&"sub.buran_engine_empty": ["В отсеке двигателя остался лишь заиндевевший карбюратор.", "Only the frosted carburetor remains in the engine bay."],
	&"it.poi_buran_trunk": ["[E] Открыть багажный кофр «Бурана»", "[E] Open Buran luggage trunk"],
	&"note.buran_semenov": ["ЗАПИСКА СЕМЁНОВА (из кофра снегохода)\n\n12 ноября. Заглох на подъеме из оврага... Искра пропала. В лесу стоит ровный монотонный звук, будто под снегом крутится тяжелый маховик. Запасную свечу забыл в сарае. Придется идти к избе пешком по насту.\n\nЕсли кто найдет машину — знайте: координаты кратера Свердловск засекретил не просто так. 61°54'N, 59°27'E. На дне воронки нет ничего земного. И оно не мертвое.", "SEMYONOV'S NOTE (from snowmobile trunk)\n\nNov 12. Engine sputtered out climbing the ravine... No spark. A deep monotone hum vibrates through the woods, as if a massive flywheel spins beneath the snow. Forgot the spare plug in the shed. Walking back to the cabin over the crust.\n\nIf anyone finds this rig — know this: Sverdlovsk classified the crater coordinates for a reason. 61°54'N, 59°27'E. There is nothing earthly at the bottom of that pit. And it is not dead."],
	&"sub.buran_milk_eaten": ["В кофре обнаружена банка сгущенного молока 'Главконсерв' 1980 г. Калории согревают тело (+30 тепла).", "Found a 1980 tin of sweetened condensed milk in the trunk. The rich calories warm you (+30 warmth)."],
	&"it.poi_trap": ["[E] Осмотреть капкан №5", "[E] Inspect wolf trap #5"],
	&"sub.poi_trap_clamped": ["Тяжелый стальной капкан намертво захлопнут на ветке. В зубьях зажаты клочья серой технической ваты... Точно такой же утеплен ватник Ырки.", "Heavy steel trap clamped tight on a broken pine bough. Shreds of grey technical cotton wadding are caught in the teeth... Exactly like the lining of Yrka's padded jacket."],
	&"it.poi_tent_case": ["[E] Осмотреть полевой планшет 1974 г.", "[E] Inspect 1974 field case"],
	&"note.tent_geologists": ["ПОЛЕВОЙ ЖУРНАЛ ЭКСПЕДИЦИИ №14 (1974 г.)\n\n'...18 сентября. Шурф на глубине 48 метров вскрыл плиту из монолитного черного базальта с зеркальной поверхностью. Алмазный бур сточился за 10 минут. Радиационный фон нормальный, но у всех буровиков начались синхронные носовые кровотечения.\n\n3 октября. По ночам слышен подземный ритмичный стук, ровно в 03:10. Будто кто-то стучит изнутри плиты кувалдой. Сворачиваем лагерь немедленно.'", "FIELD JOURNAL OF EXPEDITION #14 (1974)\n\n'...Sept 18. Test hole at 48m depth hit a slab of solid black basalt with a polished mirror finish. Diamond drill ground down in 10 minutes. Background radiation normal, but the entire drilling crew suffered synchronized nosebleeds.\n\nOct 3. At night a rhythmic subterranean thumping is heard, sharp at 03:10. As if someone is striking the slab with a sledgehammer from inside. Abandoning camp immediately.'"],
	&"it.poi_tent_ammo": ["[E] Вскрыть жестяную коробку с ракетами", "[E] Open tin flare box"],
	&"sub.tent_flares_found": ["В жестяной коробке найдены две сигнальные ракеты красного огня 1974 года (+2 ракеты).", "Found two 1974 red signal flare cartridges inside the tin box (+2 flares)."],
	&"sub.tent_ammo_empty": ["Коробка пуста, на дне лишь следы парафина.", "The tin is empty, only paraffin wax traces remain on the bottom."],
	&"it.poi_shrine": ["[E] Осмотреть мансийское капище", "[E] Inspect Mansi forest shrine"],
	&"sub.shrine_amulet_taken": ["Среди берестяных подношений найден резной амулет духа Менква из кости оленя. Чувство всепоглощающего ужаса отступает (-12 страха). Раз за ночь оберег остановит погоню.", "Among the birch bark offerings rests a Menkwa spirit amulet carved from deer bone. The pervasive dread recedes (-12 tension). Once a night the amulet will stop a chase."],
	&"sub.shrine_prayed": ["На кормушке лежат кедровые шишки и полоски красной ткани. Духи тайги спокойны.", "Pine cones and strips of red cloth lie on the feeder. The taiga spirits are appeased."],
	&"it.poi_finger": ["[E] Осмотреть репер «Чёртова Пальца»", "[E] Inspect Devil's Finger benchmark"],
	&"sub.poi_finger_marker": ["Базальтовый останец высотой 7 метров. В камень вбит латунный геодезический репер Главного управления геодезии и картографии СССР 1961 г. Стрелка компаса рядом с камнем начинает бешено вращаться.", "Basalt rock spire 7 meters high. A 1961 brass geodetic marker of the USSR Cartography Bureau is anchored in the stone. The compass needle spins frantically near the rock face."],
	&"it.poi_tower": ["[E] Осмотреть основание вышки триангуляции", "[E] Inspect triangulation tower base"],
	&"sub.tower_flares_found": ["У основания деревянной вышки в цинковом ящике найдены две герметичные сигнальные ракеты (+2 ракеты).", "At the wooden tower base, two sealed signal flare cartridges were found in a zinc box (+2 flares)."],
	&"sub.tower_flares_empty": ["Ящик у опоры вышки пуст.", "The zinc box at the tower foot is empty."],
	&"it.poi_shaft": ["[E] Заглянуть в шурф №7", "[E] Peer into exploration shaft #7"],
	&"sub.poi_shaft_void": ["Черный квадратный ствол шахты, обшитый лиственничными плахами. Из глубины тянет ледяным воздухом и доносится утробный механический гул.", "Black square shaft opening lined with larch timbers. A freezing draft and a deep, guttural mechanical drone rise from the abyss."],
	&"it.poi_beacon": ["[E] Осмотреть аварийный маяк «Комар»", "[E] Inspect 'Komar' distress beacon"],
	&"note.komar_beacon": ["БИРКА АВАРИЙНОГО МАЯКА Р-855 (на стропах кедра)\n\n'Борт Ми-8 №24118. Поисково-спасательный отряд Уральского УГА. 19 декабря 1979 г.\n\nЗапись на корпусе: Высота 80 метров над хребтом. Рулевой винт не отказал — лопасти перекушены в воздухе чем-то, что не отобразилось на локаторе. Командир погиб. Идем пешком на свет мачты «Кедр-7»... Если найдете маяк — не задерживайтесь здесь в сумерках.'", "R-855 DISTRESS BEACON TAG (on cedar cords)\n\n'Helicopter Mi-8 #24118. Ural Civil Aviation Search & Rescue. Dec 19, 1979.\n\nHandwritten note on casing: Altitude 80m over the ridge. Tail rotor didn't fail — blades sheared mid-air by something invisible to radar. Captain dead. Walking toward Kedr-7 mast beacon light... If you find this beacon — do not linger here at dusk.'"],
	&"it.poi_sledge": ["[E] Осмотреть охотничьи нарты", "[E] Inspect hunting sledge"],
	&"sub.sledge_berries_taken": ["В берестяном коробе на санях найден кисет с сушеными ягодами рябины и шиповника (+20 тепла).", "Found a birch pouch with dried rowan and rosehip berries in the sledge (+20 warmth)."],
	&"sub.sledge_empty": ["В нартах осталась лишь охапка заиндевевших еловых лап.", "Only a bundle of frosted spruce branches remains in the sledge."],
	&"it.poi_seismo": ["[E] Осмотреть пост сейсмометрии №12", "[E] Inspect seismo-post #12"],
	&"note.seismo_post_trace": ["ЛЕНТА СЕЙСМОГРАФА ВЭГИК (пост №12, ноябрь 1982 г.)\n\n'Сводка колебаний почвы: Еженощно ровно в 03:10:00 фиксируется серия гармонических импульсов частотой 14.2 Гц. Затухание нулевое. Амплитуда нарастает на 2% каждую ночь.\n\nЗаключение дежурного геофизика: Природа колебаний техногенная. Под хребтом работает механизм циклопической мощности.'", "VEGIK SEISMOGRAPH TAPE (Post #12, Nov 1982)\n\n'Ground tremor log: Nightly at exactly 03:10:00, a series of harmonic pulses at 14.2 Hz is recorded. Damping is zero. Amplitude increases by 2% each night.\n\nDuty geophysicist conclusion: Tremor origin is synthetic. A mechanism of cyclopean power operates beneath the ridge.'"],

	# --- Проявка снимков POI и оптическая лупа ---
	&"darkroom.loupe_poi_revealed": ["ОПТИЧЕСКАЯ ЛУПА: ВЫЯВЛЕНА СКРЫТАЯ АНОМАЛИЯ", "OPTICAL LOUPE: HIDDEN ANOMALY REVEALED"],
	&"poi.poi_snowmobile.cap": ["Дневная съемка: снегоход Семёнова в овраге", "Daytime shot: Semyonov's snowmobile in ravine"],
	&"poi.poi_snowmobile.loupe": ["При 8-кратном увеличении в треснувшем стекле кабины проступает бледное лицо без глазниц, смотрящее прямо в объектив.", "Under 8x magnification, a pale eyeless face staring straight into the lens emerges in the cracked windshield."],
	&"poi.poi_trap.cap": ["Дневная съемка: капкан №5 с ватой", "Daytime shot: trap #5 with wadding"],
	&"poi.poi_trap.loupe": ["Среди клочьев серой ваты в зубьях капкана отчетливо видны три черных омертвевших сустава человеческих пальцев.", "Among the shreds of grey wadding in the jaws, three blackened necrotic human finger joints are clearly visible."],
	&"poi.poi_tent.cap": ["Дневная съемка: палатка 1974 года", "Daytime shot: 1974 expedition tent"],
	&"poi.poi_tent.loupe": ["Сквозь заиндевелый брезент изнутри палатки просвечивают контуры двух сидящих плечом к плечу неподвижных тел.", "Through the frosted canvas, silhouettes of two motionless bodies sitting shoulder to shoulder shine from inside."],
	&"poi.poi_shrine.cap": ["Дневная съемка: капище духов", "Daytime shot: forest spirit shrine"],
	&"poi.poi_shrine.loupe": ["Резные мансийские тамги на снимке сочатся свежей густой смолой, хотя на сорокаградусном морозе смола замерзает мгновенно.", "The carved Mansi tamgas seep fresh thick sap in the photograph, though in -40°C sap freezes instantly."],
	&"poi.poi_finger.cap": ["Дневная съемка: останец «Чёртов Палец»", "Daytime shot: 'Devil's Finger' basalt rock"],
	&"poi.poi_finger.loupe": ["На гладкой поверхности базальта под увеличением виден глубоко вдавленный в камень отпечаток ладони с шестью пальцами.", "On the basalt face under magnification, an imprint of a six-fingered palm deeply pressed into the stone is revealed."],
	&"poi.poi_tower.cap": ["Дневная съемка: вышка триангуляции", "Daytime shot: triangulation tower"],
	&"poi.poi_tower.loupe": ["На верхней площадке деревянной вышки проявилась длинная суставчатая тень, обвившая перекладины.", "At the tower apex platform, a long jointed shadow wrapped around the crossbeams is revealed."],
	&"poi.poi_shaft.cap": ["Дневная съемка: геологоразведочный шурф №7", "Daytime shot: exploration shaft #7"],
	&"poi.poi_shaft.loupe": ["Из черного провала шурфа поднимаются концентрические вихри тумана, складывающиеся в очертания спирали.", "From the shaft's black opening rise concentric mist swirls that form into a spiral pattern."],
	&"poi.poi_beacon.cap": ["Дневная съемка: парашютный маяк «Комар»", "Daytime shot: 'Komar' parachute beacon"],
	&"poi.poi_beacon.loupe": ["Оранжевый парашютный шелк на ветвях обвит десятками тонких черных нитей, тянущихся вверх прямо в небо.", "The orange parachute silk in the branches is woven through with dozens of thin black threads reaching straight up into the sky."],
	&"poi.poi_sledge.cap": ["Дневная съемка: охотничьи нарты", "Daytime shot: hunter's sledge"],
	&"poi.poi_sledge.loupe": ["Под снежным покровом на санях проступают очертания стянутого веревками продолговатого тела.", "Beneath the snow covering on the sledge, the outline of an elongated cord-bound body shows through."],
	&"poi.poi_seismo.cap": ["Дневная съемка: сейсмопост №12", "Daytime shot: seismo-post #12"],
	&"poi.poi_seismo.loupe": ["Маятник прибора на снимке смазан от сильнейшей вибрации, хотя снег на стеклянном колпаке лежал нетронутым.", "The pendulum needle is blurred from violent vibration, though the snow on the glass bell jar lay undisturbed."],

	# --- Дневной радиоэфир ---
	&"sig.day_metronome": ["[Эфир: монотонный, глухой стук часового механизма — 60 ударов в минуту]", "[Broadcast: monotone, dull pulse of a clockwork mechanism — 60 bpm]"],
	&"sig.day_radioplay.1": ["[Эфир: 50-е гг.] «...Ты слышишь? В сенях кто-то ходит... — Полно тебе, Марья, это кедр скрипит...»", "[Broadcast: 1950s] '...Do you hear that? Footsteps in the hall... — Hush Marya, it's just the cedar creaking...'"],
	&"sig.day_radioplay.2": ["[Эфир: 50-е гг.] «...Нет, Андрей... Кедр не дышит у порога... Кедр не зовет по имени...»", "[Broadcast: 1950s] '...No, Andrey... A cedar doesn't breathe at the sill... A cedar doesn't call by name...'"],
	&"sig.day_geologists.1": ["[Эфир: «Таёжная-4»] «...База, мы у высоты 214... Склоны оврага оплавлены в зеленый шлак...»", "[Broadcast: 'Tayozhnaya-4'] '...Base, we are at hill 214... The ravine slopes are melted into green slag...'"],
	&"sig.day_geologists.2": ["[Эфир: «Таёжная-4»] «...Снег испарился на полста метров. В центре провал, из него идет пар...»", "[Broadcast: 'Tayozhnaya-4'] '...Snow evaporated for fifty meters. A pit in the center, steam rising...'"],
	&"sig.day_geologists.3": ["[Эфир: «Таёжная-4»] «...И компас... стрелка указывает строго на дно провала. Прием.»", "[Broadcast: 'Tayozhnaya-4'] '...And the compass... needle points straight down into the pit. Over.'"],
	&"hid.metronome": ["Координаты: 61°54'N, 59°27'E", "Coordinates: 61°54'N, 59°27'E"],
	&"hid.radioplay": ["Шепот Семёнова: «Они повторяют наши слова»", "Semyonov's whisper: 'They repeat our words'"],
