	# --- Новые магнитные ленты для магнитофона станции ---
	&"tape.tape_field": ["Полевой дневник геофизика Дубова (РЛС «Енисей»)", "Geophysicist Dubov's Field Diary ('Yenisey' Radar)"],
	&"tape.tape_bunker": ["Спецсвязь-17 (архив объекта «Отзвук»)", "Special Comms-17 (Otzvuk Facility Archive)"],
	&"sig.tape_field.1": ["[Пленка: свист ветра и шаги в снегу] «...14 октября. Перевал Отортен. Мы вышли на радиомолчание три дня назад...»", "[Tape: howling wind and snow crunches] '...Oct 14. Otorten pass. We entered radio silence three days ago...'"],
	&"sig.tape_field.2": ["[Пленка: треск] «...По ночам из-под снега идет низкая пульсация. Мой сейсмоприбор зашкаливает. Оно дышит...»", "[Tape: static] '...At night a deep vibration rises from beneath the snow. My seismograph is pinned. It breathes...'"],
	&"sig.tape_field.3": ["[Пленка] «...Если кто слышит эту запись: не ищите нас. То, что спит под хребтом, просыпается от радиоволн.»", "[Tape] '...If anyone hears this recording: do not look for us. What sleeps beneath the ridge awakens to radio waves.'"],
	&"sig.tape_bunker.1": ["[Запись спецсвязи] «...Внимание всем постам Гражданской Обороны. Объект 'Отзвук' переведен на режим консервации...»", "[Special comms tape] '...Attention all Civil Defense posts. Facility Otzvuk placed in deep mothball status...'"],
	&"sig.tape_bunker.2": ["[Запись спецсвязи: треск разрядов] «...Зафиксировано сквозное проплавление базальтового свода на глубине 30 метров. Персоналу эвакуироваться немедленно.»", "[Special comms: static bursts] '...Complete basalt ceiling penetration recorded at depth of 30 meters. All personnel must evacuate immediately.'"],
	&"sig.tape_bunker.3": ["[Запись спецсвязи: низкий механический стон] «...Оно не излучает радиации. Оно поглощает свет и звук. Связь обрывается...»", "[Special comms: low mechanical drone] '...It emits no radiation. It consumes light and sound. Carrier dying...'"],
	&"hid.tape_field": ["Координаты экспедиции: 61°54'N, 59°27'E\nГоризонт-40: ходок за завалом в устье, слева. Разбирать — там наш лагерь.", "Expedition coordinates: 61°54'N, 59°27'E\nHorizon-40: an adit behind the rubble at the mouth, on the left. Clear it — our camp is there."],
