	&"sup.r_job": ["наряд", "field job"],
	&"fj.k_ams_reset": ["%s — не выходит на связь: перезапустить", "%s — silent: restart it"],
	&"fj.k_ams_battery": ["%s — сел аккумулятор: привезти новый из гаража", "%s — dead battery: bring a new one from the garage"],
	&"fj.k_ams_ice": ["%s — обледенели датчики: сбить лёд", "%s — sensors iced over: knock the ice off"],
