	&"corpus.poster_title": ["ТОВАРИЩ НАБЛЮДАТЕЛЬ!", "COMRADE OBSERVER!"],
	&"corpus.poster_body": ["Сводка, переданная в срок, — твой вклад в безопасность полётов и в план пятилетки.\n\nНЕ ПРОПУСКАЙ СРОКОВ!", "A report sent on time is your contribution to flight safety and the five-year plan.\n\nNEVER MISS AN OBSERVATION!"],
	&"corpus.order_title": ["ПРИКАЗ № 41", "ORDER No. 41"],
	&"corpus.order_body": ["По ст. «Кедр-7». Корпус на ночь не обесточивать. Шар-пилот не выпускать после 22:00. Дежурный — Мальцев В.", "Kedr-7 station. Do not de-energise the building at night. No pilot balloons after 22:00. On duty: Mal'tsev V."],
	&"corpus.sched_title": ["СРОКИ", "SCHEDULE"],
	&"corpus.sched_body": ["Сводка: 00:00, 02:00\nПосле 03:00 —\nсвязь не вести", "Report: 00:00, 02:00\nAfter 03:00 —\nno radio traffic"],
	&"corpus.board_note": ["кто стоит у пульта\nв темноте — не я. С.", "whoever stands at the panel\nin the dark — isn't me. S."],
	&"corpus.leer_title": ["ВЫХОДЯ — ДЕРЖИСЬ ЛЕЕРА", "GOING OUT — HOLD THE ROPE"],
	&"corpus.leer_body": ["В пургу без леера не ходить. Отзывают — не отзывайся.", "Never walk in a blizzard without the rope. If called — don't answer."],
	&"it.damper_close": ["[E] Прикрыть поддувало — гореть дольше, греть слабее", "[E] Close the ash door — burn longer, heat less"],
	&"it.damper_open": ["[E] Открыть поддувало", "[E] Open the ash door"],
	&"sub.damper_closed": ["Поддувало прикрыто: дрова будут тлеть долго, но тепла меньше.", "Ash door closed: the wood will smoulder for a long time, but give less heat."],
	&"sub.damper_opened": ["Поддувало открыто — печь разгорается.", "Ash door open — the stove roars up."],
	&"it.flue_close": ["[E] Закрыть вьюшку", "[E] Close the flue damper"],
	&"it.flue_open": ["[E] Открыть вьюшку", "[E] Open the flue damper"],
	&"sub.flue_closed_cold": ["Вьюшка закрыта: прогоревшая печь отдаст тепло вдвое дольше.", "Flue closed: the burnt-out stove will hold its heat twice as long."],
	&"sub.flue_closed_fire": ["Вьюшка закрыта, а в печи огонь. Дым пойдёт в дом — угоришь.", "Flue closed with a fire still burning. The smoke will come inside — you'll suffocate."],
	&"sub.flue_opened": ["Вьюшка открыта, тяга есть.", "Flue open, the draught is back."],
	&"it.switch_off": ["[E] Рубильник: погасить свет в доме", "[E] Main switch: lights off in the house"],
	&"it.switch_on": ["[E] Рубильник: включить свет в доме", "[E] Main switch: lights on in the house"],
	&"sub.switch_off": ["Щёлк. Дом погас. Дизель сбросил обороты — солярки хватит втрое дольше.", "Clack. The house goes dark. The diesel drops to idle — the fuel will last three times longer."],
	&"sub.switch_on": ["Свет в доме.", "Lights on in the house."],
	&"stove.embers": ["прогорела, кладка ещё тёплая", "burnt out, the brickwork is still warm"],
	&"it.trunk": ["[E держать] Сдвинуть сундук", "[hold E] Shove the trunk aside"],
	&"it.bcellar": ["[E] Люк в подпол", "[E] Cellar hatch"],
	&"it.bcellar_night": ["[E] Люк в подпол (Брагин писал: ночью не открывать)", "[E] Cellar hatch (Bragin wrote: don't open it at night)"],
	&"it.bcellar_up": ["[E] Наверх, в дом", "[E] Up into the house"],
	&"sub.trunk_moved": ["Под сундуком — люк. Гвозди-двухсотки вытащены. Изнутри.", "Under the trunk — a hatch. The long nails have been pulled out. From the inside."],
	&"sub.cellar_in": ["Тепло. Земля тёплая, как печь. Банки с огурцами не замёрзли за двадцать два года.", "It's warm. The earth is warm as a stove. The pickle jars haven't frozen in twenty-two years."],
	&"sub.cellar_knock": ["(Снизу. Под полом подпола — стук.)", "(From below. Under the cellar floor — knocking.)"],
	&"sub.cellar_step": ["(Скрипнула ступенька за спиной. Вторая.)", "(A step creaked behind you. The second one.)"],
	&"lore.cellar_wall": ["ПОКА ГОВОРИШЬ —\nМОЛЧИТ", "WHILE YOU SPEAK —\nIT'S SILENT"],
	&"it.cache_panel": ["[E держать] Простучать панель — звук пустой", "[hold E] Tap the panel — it sounds hollow"],
	&"it.cache_plinth": ["[E держать] Отогнуть плинтус — он отходит", "[hold E] Prise the skirting — it's loose"],
	&"it.cache_attic": ["[E] Коробка из-под посылки", "[E] An old parcel box"],
	&"it.cache_drawer": ["[E держать] Ящик стола — дно стучит пусто", "[hold E] Desk drawer — the bottom sounds hollow"],
	&"it.walled_boards": ["[E держать] Заколоченное окно — отодрать доски", "[hold E] Boarded window — prise the boards off"],
	&"it.walled_go": ["[E] Пролезть в проём", "[E] Climb through the gap"],
	&"it.walled_back": ["[E] Обратно, в архив", "[E] Back into the archive"],
	&"it.walled_chair": ["[E] Стул с ватником", "[E] Chair with a quilted jacket"],
	&"sub.walled_in": ["Не улица. Комната. Иней на стенах, стакан чая во льду, календарь — декабрь 1979-го. Здесь никто не жил четыре года. Здесь кто-то сидел минуту назад.", "Not outside. A room. Frost on the walls, a glass of tea frozen solid, a calendar — December 1979. Nobody has lived here for four years. Somebody was sitting here a minute ago."],
	&"sub.walled_voice": ["(Из архива, тоненько:) «Папа... папа, открой, я замёрзла».", "(From the archive, in a thin voice:) \"Daddy... daddy, open up, I'm cold.\""],
	&"sub.walled_chair": ["Сиденье тёплое. Продавлено — как будто встали только что. Ватник на спинке ещё хранит форму плеч.", "The seat is warm. Dented — as if someone just stood up. The jacket on the back still holds the shape of shoulders."],
	&"lore.calendar": ["ДЕКАБРЬ\n1979", "DECEMBER\n1979"],
	&"it.gsafe_locked": ["[E] Сейф «Сибирь» — кодовый замок", "[E] Sibir safe — combination lock"],
	&"it.gsafe_open": ["[E] Сейф открыт — отчёт", "[E] The safe is open — the report"],
	&"safe.title": ["СЕЙФ «СИБИРЬ» · КОДОВЫЙ ЗАМОК", "SIBIR SAFE · COMBINATION LOCK"],
	&"safe.heading": ["Набери код на барабанах", "Dial the code"],
	&"safe.row": ["Код (четыре цифры)", "Code (four digits)"],
	&"safe.open": ["Открыть", "Open"],
	&"safe.hint": ["Код где-то в бумагах. Голубев перекодировал сейф на важную для него дату. E — отойти", "The code is somewhere in the papers. Golubev reset the safe to a date that mattered to him. E — step away"],
	&"safe.wrong": ["Не тот код. Замок щёлкнул вхолостую.", "Wrong code. The lock clicked uselessly."],
	&"it.tunnel_boards": ["[E держать] Половицы у стены ходят — подковырнуть", "[hold E] The floorboards by the wall are loose — prise them up"],
	&"it.tunnel_down": ["[E] Люк вниз (сквозняк, пахнет сырым бетоном)", "[E] Hatch going down (a draught, smells of damp concrete)"],
	&"sub.tunnel_found": ["Под половицами — люк. Скобы уходят вниз, в темноту. Оттуда тянет теплом и озоном.", "Under the boards — a hatch. Rungs go down into the dark. Warm air and ozone drift up."],
	&"sub.tunnel_in": ["Кабельный тоннель. Тридцать метров под корпусом. Кабели уходят на юг — к «Отзвуку».", "A cable tunnel. Thirty metres under the building. The cables run south — towards Otzvuk."],
	&"sub.tunnel_bang": ["(За стеной ударили. Ровно там, где ты стоишь.)", "(Something hit the wall. Exactly where you're standing.)"],
	&"it.tunnel_up": ["[E] Наверх, в архив", "[E] Up into the archive"],
	&"it.tunnel_door": ["[E] Гермодверь — «Отзвук»", "[E] Blast door — Otzvuk"],
	&"it.tunnel_door_back": ["[E] Дверь в кабельный тоннель", "[E] Door to the cable tunnel"],
	&"lore.chalk_1": ["НЕ ОБОРАЧИВАЙСЯ", "DON'T TURN AROUND"],
	&"lore.chalk_2": ["Курочкин В. П.\n14.08.61\nя ответил", "Kurochkin V. P.\n14.08.61\nI answered"],
	&"lore.chalk_3": ["ОНО ИДЁТ ЗА СТЕНОЙ\nВ НОГУ", "IT WALKS BEHIND THE WALL\nIN STEP"],
	&"book.keys": ["←/→ или клик по странице — листать • E — закрыть", "←/→ or click a page — turn • E — close"],
	&"book.secret": ["СОВ. СЕКРЕТНО", "TOP SECRET"],
	&"it.book": ["[E] Взять: «%s»", "[E] Pick up: “%s”"],
	&"it.book_read": ["[E] Перечитать: «%s»", "[E] Read again: “%s”"],
	&"case.books": ["— Прочитано документов станции: %d из %d.", "— Station documents read: %d of %d."],
	&"efir.morse_line": ["(морзянка) %s", "(morse) %s"],
	&"efir.cipher_line": ["(цифры) %s", "(numbers) %s"],
	&"efir.tape_pool": ["Эфир %d кГц — %s", "Air %d kHz — %s"],
	&"efir.kind_morse": ["морзе", "morse"],
	&"efir.kind_cipher": ["цифровые группы", "number groups"],
	&"efir.after3_name": ["(в наушниках, сквозь треск, кто-то медленно произносит твою фамилию)", "(in the headphones, through the crackle, someone slowly says your surname)"],
	&"efir.after3_knock": ["(в наушниках ничего не слышно — а за спиной будто стукнули в дверь?)", "(you can't hear a thing with the headphones on — was that a knock behind you?)"],
	&"efir.pool_tag": ["Бирка на ящике: %d кГц.", "Tag on the box: %d kHz."],
	&"efir.find_toast": ["Находка эфира: %d из %d", "Radio find: %d of %d"],
	&"efir.pool_note.0": ["Брезентовый мешок обходчика и рация «Недра-П» с примёрзшим ключом. Последняя запись в журнале обхода: «Слышу своё имя из-под снега. Иду проверить».", "A lineman's canvas bag and a Nedra-P radio with the key frozen down. Last entry in his patrol log: “I can hear my name under the snow. Going to check.”"],
	&"efir.pool_note.1": ["Радиостанция на нартах. Наушники надеты на пустой капюшон тулупа. Капюшон заиндевел изнутри — будто в нём ещё дышали.", "A radio on a sled. The headphones are on an empty sheepskin hood. The hood is frosted on the inside — as if someone was still breathing in it."],
	&"efir.pool_note.2": ["Ящик с рацией, а рядом — сапоги. Шесть пар, аккуратно в ряд, носками к лесу.", "A box with a radio, and boots next to it. Six pairs, neatly in a row, toes pointing at the forest."],
	&"efir.pool_note.3": ["Рация в дупле, микрофон заклеен варежкой. На варежке — следы зубов.", "A radio in a hollow tree, the microphone taped over with a mitten. There are teeth marks on the mitten."],
	&"efir.pool_note.4": ["Планшет с картой района. Карандашом обведён круг вокруг станции. Подпись: «везде одинаково далеко».", "A map case with a chart of the district. A pencil circle around the station. The note says: “equally far in every direction.”"],
	&"efir.pool_note.5": ["На крышке ящика — список дежурных «Кедра-7». Фамилия Лазарева зачёркнута и вписана снова, другой рукой.", "On the lid of the box — a list of Kedr-7 duty officers. Lazarev's name is crossed out and then written in again, in a different hand."],
	&"efir.pool_note.6": ["Рация включена на передачу. В эфир уходит дыхание — твоё. Ты задерживаешь вдох — в наушниках вдох продолжается.", "The radio is switched to transmit. Breathing goes out on air — yours. You hold your breath — in the headphones the breath goes on."],
	&"efir.pool_note.7": ["Ракетница без ракет и бланк заявки на борт: «Отказано, до весны». Подпись — Большая Земля. Дата — завтрашняя.", "A flare gun with no flares and a flight request form: “Denied, wait for spring.” Signed: Mainland. Dated tomorrow."],
	&"efir.pool_note.8": ["Ошейник рядом с рацией. На ошейнике — «Найда». У тебя собака с тем же именем.", "A dog collar next to the radio. The tag says “Nayda”. Your dog has the same name."],
	&"efir.pool_note.9": ["В ящике, под рацией, — тетрадь. Твой почерк. Записи о ночах, которых ещё не было.", "Inside the box, under the radio — a notebook. Your handwriting. Entries about nights that haven't happened yet."],
	&"efir.find.beacon": ["Под ёлкой, в снегу по пояс — армейский ключ-автомат на аккумуляторе. Лента-кольцо крутится сама и стучит одно и то же. На крышке ножом: «СЕМЁНОВ. 12.XI. Если читаешь — не отвечай им после трёх». Рядом — его рукавица. Следов от неё не идёт никуда.", "Under a spruce, waist-deep in snow — an army automatic keyer on a battery. A tape loop turns by itself and keys the same message. Carved into the lid: “SEMYONOV. 12 NOV. If you're reading this — don't answer them after three.” His mitten lies beside it. No tracks lead away from it."],
	&"efir.find.bunker": ["У люка — катушечный магнитофон, провод уходит под крышку бункера. На катушке карандашом: «Сем. — образец 3». Это не эфир, это запись. Голос Семёнова крутят отсюда — каждую ночь, с того дня, как он пропал.", "By the hatch — a reel-to-reel recorder, its cable running under the bunker lid. Pencilled on the reel: “Sem. — sample 3”. It isn't a broadcast, it's a recording. Semyonov's voice is being played from here — every night, since the day he vanished."],
	&"efir.find.izba": ["Под нарами — детский приёмник «Зорька». Отсека для батарей у него нет вовсе. Играет колыбельная. На донышке нацарапано: «Наденьке от папы. Кедр-7, 1958».", "Under the bunk — a child's Zorka radio. It has no battery compartment at all. It is playing a lullaby. Scratched on the bottom: “To Nadenka from Dad. Kedr-7, 1958.”"],
	&"efir.find.hole": ["Из проруби тянется шнур, во лёд вмёрзли наушники. Если наклониться, из-подо льда слышно: «Сынок, открой, мама замёрзла». Шнур уходит вниз, в черноту — и он тёплый.", "A cord runs out of the ice hole; a pair of headphones is frozen into the ice. Lean closer and you hear from under the ice: “Son, open up, mother's freezing.” The cord goes down into the dark — and it is warm."],
	&"efir.find.repeater": ["В шкафу ретранслятора — чужой блок с маркировкой «в/ч 03110». Шифратор: бумажная лента с группами цифр. Последние группы по таблице Семёнова — твоя фамилия.", "In the repeater cabinet — a foreign unit stamped “Unit 03110”. A cipher machine: a paper tape with number groups. By Semyonov's table, the last groups spell your surname."],
	&"efir.find.alone": ["Под половицей кладовой — армейская станция, тёплая, будто только выключили. Ключ замкнут проволокой. Шкала стоит на 5210. Это она каждую ночь передаёт: «Виктор находится один».", "Under a floorboard in the storeroom — an army transmitter, warm as if just switched off. The key is shorted with wire. The dial reads 5210. This is what broadcasts every night: “Viktor is alone.”"],
	&"efir.find.roll": ["На вышке — магнитофон с кольцом ленты. Перекличка станций, 1979 год. «Кедр-7» отвечает четыре раза, четырьмя голосами: Брагин, Лазарев, Семёнов. Четвёртый голос — твой.", "Up in the tower — a recorder with a tape loop. A station roll call, 1979. Kedr-7 answers four times, in four voices: Bragin, Lazarev, Semyonov. The fourth voice is yours."],
	&"efir.find.otzvuk": ["Шкала на боку «ОТЗВУКА-2»: две отметки краской — 5310 и 4990. Цифровая станция, что ночами читает группы, — этот ящик. Он не принимает. Он отвечает.", "A dial on the side of OTZVUK-2: two paint marks — 5310 and 4990. The numbers station that reads groups at night is this box. It doesn't receive. It answers."],
	&"efir.end.answer": ["Ты знал, что под половицей стоит станция, которая говорит за тебя. Всё равно ответил. В Свердловске потом долго не могли понять, почему сводки «Кедра-7» шли ещё две недели.", "You knew there was a transmitter under the floor that spoke for you. You answered anyway. In Sverdlovsk they could never work out why Kedr-7's reports kept coming for two more weeks."],
	&"efir.end.burn": ["Катушку с голосом Семёнова ты бросил в огонь первой. Она горела долго и тихо — будто кто-то шептал.", "You threw the reel with Semyonov's voice into the fire first. It burned slowly and quietly — as if someone was whispering."],
	&"efir.end.leave": ["Ты слышал перекличку, где «Кедр-7» отвечает четыре раза. Ты не стал ждать, когда отзовёшься пятым.", "You heard the roll call where Kedr-7 answers four times. You didn't wait to become the fifth."],
	&"efir.end.silence": ["Утром у проруби — наушники, вмёрзшие в лёд. Ты их не трогал. К полудню шнур сам ушёл под воду.", "In the morning, by the ice hole — the headphones frozen into the ice. You didn't touch them. By noon the cord had slipped under the water on its own."],
	&"efir.end.source": ["Ты знал, что цифры диктует этот ящик. Провода рвались с треском — как эфир, когда в нём вдруг никого не остаётся.", "You knew it was this box reading the numbers. The wires tore with a crackle — like the air when suddenly no one is left on it."],
	&"efir.end.echo": ["Ключ Семёнова всё ещё стучал в лесу: «не отвечай после трёх». Ты ответил. Тебе — уже можно было.", "Semyonov's keyer was still tapping in the forest: “don't answer after three.” You answered. For you, it no longer mattered."],
